---
// Cargador de productos para migrar el catálogo a Tiendanube.
// Página 100% del lado del navegador: los productos y las fotos se guardan
// en el navegador (IndexedDB) y se exportan a CSV / Excel con el formato
// de importación masiva de Tiendanube.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Cargador Tiendanube</title>
    <link rel="icon" href="/favicon.svg" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <div>
          <h1>Cargador de productos</h1>
          <p class="muted">Bonté Deco → Tiendanube</p>
        </div>
        <nav class="actions">
          <button type="button" id="btnNuevo" class="btn primary">+ Nuevo producto</button>
          <button type="button" id="btnExportCsv" class="btn">Exportar CSV Tiendanube</button>
          <button type="button" id="btnExportXlsx" class="btn">Exportar Excel</button>
          <button type="button" id="btnExportFotos" class="btn">Descargar fotos (ZIP)</button>
          <details class="menu">
            <summary class="btn">Más…</summary>
            <div class="menu-body">
              <button type="button" id="btnImportCatalogo" class="link">Traer productos del catálogo actual</button>
              <button type="button" id="btnBackup" class="link">Descargar respaldo (.json)</button>
              <label class="link">Restaurar respaldo<input type="file" id="inpBackup" accept=".json,application/json" hidden /></label>
              <label class="link small">Separador del CSV
                <select id="selSeparador">
                  <option value=",">Coma ( , )</option>
                  <option value=";">Punto y coma ( ; )</option>
                </select>
              </label>
              <button type="button" id="btnBorrarTodo" class="link danger">Borrar todos los productos</button>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section class="toolbar">
        <input type="search" id="buscador" placeholder="Buscar por código, nombre o categoría…" />
        <span id="resumen" class="muted"></span>
      </section>
      <div id="lista" class="lista"></div>
      <p id="vacio" class="vacio" hidden>
        Todavía no hay productos. Cargá uno con <strong>+ Nuevo producto</strong> o usá
        <strong>Más… → Traer productos del catálogo actual</strong>.
      </p>
    </main>

    <!-- Formulario de producto -->
    <dialog id="dlg">
      <form id="form" method="dialog" novalidate>
        <div class="dlg-head">
          <h2 id="dlgTitulo">Nuevo producto</h2>
          <button type="button" class="x" id="btnCerrar" aria-label="Cerrar">×</button>
        </div>

        <div class="dlg-body">
          <div class="grid2">
            <label>Código de producto (SKU) *
              <input name="codigo" required placeholder="Ej: ALM-BAHIA" autocomplete="off" />
            </label>
            <label>Nombre del producto *
              <input name="nombre" required placeholder="Ej: Almohadón Bahía Lino" autocomplete="off" />
            </label>
            <label>Categoría *
              <input name="categoria" required list="dlCategorias" placeholder="Ej: Almohadones" autocomplete="off" />
            </label>
            <label>Subcategoría
              <input name="subcategoria" list="dlSubcategorias" placeholder="Ej: Fundas" autocomplete="off" />
            </label>
            <label>Precio * <span class="muted">(sin $ ni puntos de miles)</span>
              <input name="precio" required inputmode="decimal" placeholder="Ej: 15990" />
            </label>
            <label>Precio promocional
              <input name="precioPromo" inputmode="decimal" placeholder="Opcional" />
            </label>
          </div>
          <datalist id="dlCategorias"></datalist>
          <datalist id="dlSubcategorias"></datalist>

          <fieldset>
            <legend>Fotos * <span class="muted">(mínimo 1, máximo 4 — la primera es la principal)</span></legend>
            <div id="fotos" class="fotos"></div>
            <div class="fotos-add">
              <label class="btn small">Subir fotos<input type="file" id="inpFotos" accept="image/*" multiple hidden /></label>
              <input type="url" id="inpFotoUrl" placeholder="…o pegá el link de una foto" />
              <button type="button" class="btn small" id="btnFotoUrl">Agregar link</button>
            </div>
          </fieldset>

          <fieldset>
            <legend>Variantes <span class="muted">(hasta 3: ej. Color, Medida — valores separados por coma)</span></legend>
            <div id="props"></div>
            <button type="button" class="btn small" id="btnAddProp">+ Agregar variante</button>
            <div id="variantesWrap" hidden>
              <p class="muted small">Combinaciones que se van a crear en Tiendanube. Podés cambiar precio, stock y SKU de cada una (vacío = usa el del producto / stock infinito).</p>
              <div class="tabla-scroll"><table id="tablaVariantes"></table></div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Otros datos <span class="muted">(se muestran en la descripción. Ej: Tela → Lino)</span></legend>
            <div id="datos"></div>
            <button type="button" class="btn small" id="btnAddDato">+ Agregar dato</button>
          </fieldset>

          <label>Descripción
            <textarea name="descripcion" rows="4" placeholder="Contá cómo es el producto, cuidados, etc."></textarea>
          </label>

          <details class="extra">
            <summary>Envío, stock y SEO (opcional)</summary>
            <div class="grid4">
              <label>Stock <input name="stock" inputmode="numeric" placeholder="Vacío = infinito" /></label>
              <label>Peso (kg) <input name="peso" inputmode="decimal" placeholder="Ej: 0.5" /></label>
              <label>Alto (cm) <input name="alto" inputmode="decimal" /></label>
              <label>Ancho (cm) <input name="ancho" inputmode="decimal" /></label>
              <label>Profundidad (cm) <input name="profundidad" inputmode="decimal" /></label>
              <label>Costo <input name="costo" inputmode="decimal" /></label>
              <label>Marca <input name="marca" placeholder="Bonté Deco" /></label>
              <label>Tags <input name="tags" placeholder="lino, beige" /></label>
            </div>
            <div class="grid2">
              <label>URL del producto <span class="muted">(se genera sola)</span>
                <input name="slug" placeholder="almohadon-bahia-lino" autocomplete="off" />
              </label>
              <label>Título para SEO <input name="seoTitulo" /></label>
            </div>
            <label>Descripción para SEO <input name="seoDescripcion" /></label>
            <div class="checks">
              <label class="check"><input type="checkbox" name="mostrar" checked /> Mostrar en tienda</label>
              <label class="check"><input type="checkbox" name="envioGratis" /> Envío sin cargo</label>
            </div>
          </details>

          <ul id="errores" class="errores" hidden></ul>
        </div>

        <div class="dlg-foot">
          <button type="button" class="btn danger-outline" id="btnEliminar" hidden>Eliminar</button>
          <span class="grow"></span>
          <button type="button" class="btn" id="btnCancelar">Cancelar</button>
          <button type="submit" class="btn primary">Guardar</button>
        </div>
      </form>
    </dialog>

    <div id="toast" class="toast" hidden></div>

    <style is:global>
      :root {
        --bg: #faf8f5;
        --card: #ffffff;
        --ink: #2b2620;
        --muted: #7a7166;
        --line: #e4ddd2;
        --brand: #5f4d27;
        --brand-soft: #f3f0eb;
        --danger: #b3261e;
        --ok: #2e7d32;
        --warn: #b26a00;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      .wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
      h1 { font-size: 1.35rem; margin: 0; }
      h2 { font-size: 1.15rem; margin: 0; }
      .muted { color: var(--muted); font-weight: 400; }
      .small { font-size: .85rem; }
      .top { background: var(--card); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
      .top-inner { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding-top: 12px; padding-bottom: 12px; }
      .top p { margin: 0; font-size: .85rem; }
      .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      .btn { appearance: none; border: 1px solid var(--line); background: var(--card); color: var(--ink); padding: 8px 14px; border-radius: 8px; cursor: pointer; font: inherit; display: inline-flex; align-items: center; gap: 6px; list-style: none; }
      .btn:hover { border-color: var(--brand); }
      .btn.primary { background: var(--brand); border-color: var(--brand); color: #fff; }
      .btn.primary:hover { filter: brightness(1.1); }
      .btn.small { padding: 5px 10px; font-size: .85rem; }
      .btn.danger-outline { color: var(--danger); border-color: #e7b7b3; }
      .btn:disabled { opacity: .5; cursor: progress; }
      summary.btn::-webkit-details-marker { display: none; }
      .menu { position: relative; }
      .menu-body { position: absolute; right: 0; top: calc(100% + 6px); background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 6px; min-width: 260px; box-shadow: 0 8px 24px rgba(0,0,0,.08); display: flex; flex-direction: column; }
      .link { background: none; border: 0; text-align: left; padding: 8px 10px; border-radius: 6px; cursor: pointer; font: inherit; color: var(--ink); display: flex; gap: 8px; align-items: center; justify-content: space-between; }
      .link:hover { background: var(--brand-soft); }
      .link.danger { color: var(--danger); }
      .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 18px 0 12px; }
      .toolbar input { flex: 1 1 260px; }
      input, select, textarea { font: inherit; color: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; background: #fff; width: 100%; }
      input:focus, select:focus, textarea:focus { outline: 2px solid color-mix(in srgb, var(--brand) 35%, transparent); border-color: var(--brand); }
      select { width: auto; }
      label { display: flex; flex-direction: column; gap: 4px; font-weight: 500; font-size: .9rem; }
      .lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; padding-bottom: 40px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; cursor: pointer; display: flex; flex-direction: column; transition: border-color .15s; }
      .card:hover { border-color: var(--brand); }
      .card .img { aspect-ratio: 1; position: relative; overflow: hidden; background: var(--brand-soft); display: grid; place-items: center; color: var(--muted); font-size: .85rem; }
      .card .img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .card .info { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 2px; }
      .card .cod { font-size: .78rem; color: var(--muted); font-family: ui-monospace, monospace; }
      .card .nom { font-weight: 600; }
      .card .cat { font-size: .82rem; color: var(--muted); }
      .card .pie { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: .85rem; }
      .badge { font-size: .72rem; padding: 2px 8px; border-radius: 999px; background: #e8f3e8; color: var(--ok); }
      .badge.warn { background: #fdf0dc; color: var(--warn); }
      .vacio { text-align: center; color: var(--muted); padding: 60px 16px; }
      dialog { border: 0; border-radius: 14px; padding: 0; width: min(860px, calc(100vw - 16px)); max-height: calc(100dvh - 16px); background: var(--card); color: var(--ink); }
      dialog::backdrop { background: rgba(30, 24, 16, .45); }
      dialog form { display: flex; flex-direction: column; max-height: calc(100dvh - 16px); }
      .dlg-head, .dlg-foot { display: flex; align-items: center; gap: 8px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
      .dlg-foot { border-bottom: 0; border-top: 1px solid var(--line); }
      .dlg-head h2 { flex: 1; }
      .x { border: 0; background: none; font-size: 1.6rem; line-height: 1; cursor: pointer; color: var(--muted); }
      .dlg-body { padding: 16px 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; }
      .grow { flex: 1; }
      .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
      .grid4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 12px; }
      fieldset { border: 1px solid var(--line); border-radius: 10px; padding: 12px; margin: 0; display: flex; flex-direction: column; gap: 10px; }
      legend { font-weight: 600; padding: 0 6px; font-size: .92rem; }
      .fotos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
      .foto { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: var(--brand-soft); border: 1px solid var(--line); }
      .foto img { width: 100%; height: 100%; object-fit: cover; }
      .foto .n { position: absolute; left: 6px; top: 6px; background: rgba(0,0,0,.6); color: #fff; font-size: .72rem; padding: 1px 6px; border-radius: 999px; }
      .foto .ctrl { position: absolute; right: 4px; bottom: 4px; display: flex; gap: 4px; }
      .foto .ctrl button { border: 0; background: rgba(255,255,255,.92); border-radius: 6px; cursor: pointer; padding: 2px 7px; font-size: .9rem; }
      .foto.vacia { display: grid; place-items: center; color: var(--muted); font-size: .8rem; border-style: dashed; }
      .fotos-add { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      .fotos-add input { flex: 1 1 200px; }
      .fila { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 2.4fr) auto; gap: 8px; align-items: center; margin-bottom: 8px; }
      .fila .quitar { border: 1px solid var(--line); background: #fff; border-radius: 8px; width: 36px; height: 38px; cursor: pointer; color: var(--muted); }
      .tabla-scroll { overflow-x: auto; }
      table { border-collapse: collapse; width: 100%; font-size: .85rem; }
      th, td { border-bottom: 1px solid var(--line); padding: 5px 6px; text-align: left; white-space: nowrap; }
      th { color: var(--muted); font-weight: 500; }
      td input { padding: 4px 6px; min-width: 90px; }
      .extra summary { cursor: pointer; font-weight: 600; font-size: .92rem; margin-bottom: 10px; }
      .checks { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 12px; }
      .check { flex-direction: row; align-items: center; gap: 8px; font-weight: 400; }
      .check input { width: auto; }
      .errores { margin: 0; padding: 10px 12px 10px 28px; background: #fdecea; color: var(--danger); border-radius: 8px; font-size: .9rem; }
      .toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 10px; max-width: calc(100vw - 32px); z-index: 50; box-shadow: 0 8px 24px rgba(0,0,0,.2); white-space: pre-line; }
      @media (max-width: 600px) {
        .fotos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .fila { grid-template-columns: 1fr auto; }
        .fila > :nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
        .actions .btn { padding: 7px 10px; font-size: .85rem; }
      }
    </style>

    <script>
      // ------------------------------------------------------------------
      // Formato de importación de Tiendanube (orden de columnas de la
      // planilla de "Importar y exportar productos"). Si tu planilla
      // descargada de Tiendanube tiene otros encabezados, ajustalos acá.
      // ------------------------------------------------------------------
      const COLUMNAS_TN = [
        'Identificador de URL', 'Nombre', 'Categorías',
        'Nombre de propiedad 1', 'Valor de propiedad 1',
        'Nombre de propiedad 2', 'Valor de propiedad 2',
        'Nombre de propiedad 3', 'Valor de propiedad 3',
        'Precio', 'Precio promocional', 'Peso (kg)', 'Alto (cm)', 'Ancho (cm)', 'Profundidad (cm)',
        'Stock', 'SKU', 'Código de barras', 'Mostrar en tienda', 'Envío sin cargo', 'Descripción',
        'Tags', 'Título para SEO', 'Descripción para SEO', 'Marca', 'Producto Físico',
        'MPN (Número de pieza del fabricante)', 'Sexo', 'Rango de edad', 'Costo',
      ];
      const MAX_FOTOS = 4;
      const MAX_PROPS = 3;
      const MARCA_DEFAULT = 'Bonté Deco';

      // Nombres lindos para las categorías del catálogo actual
      const NOMBRES_CATEGORIA: Record<string, string> = {
        almohadones: 'Almohadones', toallas: 'Toallas', cortinas: 'Cortinas', flores: 'Flores',
        caminos: 'Caminos de mesa', piedecama: 'Pies de cama', manteles: 'Manteles', alfombras: 'Alfombras',
        covers: 'Covers', fundas: 'Fundas', angelitos: 'Angelitos', centrosdemesa: 'Centros de mesa',
        repasadores: 'Repasadores', delantales: 'Delantales', organizadores: 'Organizadores', pillow: 'Pillow',
        servilletas: 'Servilletas', acolchados: 'Acolchados', duendes: 'Duendes',
      };

      type Foto = { id: string; url?: string; blob?: Blob };
      type Prop = { nombre: string; valores: string };
      type Dato = { nombre: string; valor: string };
      type Variante = { precio?: string; stock?: string; sku?: string };
      type Producto = {
        id: string; creado: number; actualizado: number;
        codigo: string; nombre: string; slug: string; categoria: string; subcategoria: string;
        precio: string; precioPromo: string; descripcion: string;
        fotos: Foto[]; props: Prop[]; datos: Dato[]; variantes: Record<string, Variante>;
        stock: string; peso: string; alto: string; ancho: string; profundidad: string; costo: string;
        marca: string; tags: string; seoTitulo: string; seoDescripcion: string;
        mostrar: boolean; envioGratis: boolean;
      };

      declare const XLSX: any;
      declare const JSZip: any;

      // ---------------------------- Almacenamiento (IndexedDB) ----------------------------
      const DB_NOMBRE = 'bonte-cargador';
      let dbPromise: Promise<IDBDatabase> | null = null;
      function db(): Promise<IDBDatabase> {
        dbPromise ??= new Promise((res, rej) => {
          const req = indexedDB.open(DB_NOMBRE, 1);
          req.onupgradeneeded = () => req.result.createObjectStore('productos', { keyPath: 'id' });
          req.onsuccess = () => res(req.result);
          req.onerror = () => rej(req.error);
        });
        return dbPromise;
      }
      async function tx<T>(modo: IDBTransactionMode, fn: (s: IDBObjectStore) => IDBRequest<T> | void): Promise<T> {
        const d = await db();
        return new Promise((res, rej) => {
          const t = d.transaction('productos', modo);
          const r = fn(t.objectStore('productos'));
          t.oncomplete = () => res(r ? (r as IDBRequest<T>).result : (undefined as T));
          t.onerror = () => rej(t.error);
          t.onabort = () => rej(t.error);
        });
      }
      const dbTodos = () => tx<Producto[]>('readonly', (s) => s.getAll());
      const dbGuardar = (p: Producto) => tx('readwrite', (s) => { s.put(p); });
      const dbGuardarVarios = (ps: Producto[]) => tx('readwrite', (s) => { ps.forEach((p) => s.put(p)); });
      const dbBorrar = (id: string) => tx('readwrite', (s) => { s.delete(id); });
      const dbBorrarTodo = () => tx('readwrite', (s) => { s.clear(); });

      // ---------------------------- Utilidades ----------------------------
      const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T;
      const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
      const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const lista = (s: string) => [...new Set(String(s ?? '').split(',').map((v) => v.trim()).filter(Boolean))];

      function slugify(s: string) {
        return String(s ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
          .replace(/ñ/g, 'n').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 120);
      }
      // "15.990,50" | "15990.5" | "$ 15.990" -> "15990.50" ; "" si no es número
      function normalizarPrecio(s: string): string {
        let t = String(s ?? '').replace(/[^\d.,-]/g, '');
        if (!t) return '';
        if (t.includes(',') && t.includes('.')) {
          t = t.lastIndexOf(',') > t.lastIndexOf('.') ? t.replace(/\./g, '').replace(',', '.') : t.replace(/,/g, '');
        } else if (t.includes(',')) {
          t = /,\d{1,2}$/.test(t) ? t.replace(/\./g, '').replace(',', '.') : t.replace(/,/g, '');
        } else if (/^\d{1,3}(\.\d{3})+$/.test(t)) {
          t = t.replace(/\./g, '');
        }
        const n = Number(t);
        return Number.isFinite(n) && n >= 0 ? String(Math.round(n * 100) / 100) : '';
      }
      const fmtPrecio = (s: string) => { const n = normalizarPrecio(s); return n ? '$ ' + Number(n).toLocaleString('es-AR') : '—'; };

      function toast(msg: string, ms = 3500) {
        const t = $('#toast');
        t.textContent = msg; t.hidden = false;
        clearTimeout((toast as any)._t);
        (toast as any)._t = setTimeout(() => (t.hidden = true), ms);
      }
      function descargar(blob: Blob, nombre: string) {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = nombre;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      }
      const fecha = () => new Date().toISOString().slice(0, 10);

      // URLs de objeto para mostrar blobs (se reciclan)
      const urlCache = new WeakMap<Blob, string>();
      const srcFoto = (f: Foto) => f.url || (f.blob ? (urlCache.get(f.blob) ?? (urlCache.set(f.blob, URL.createObjectURL(f.blob)), urlCache.get(f.blob)!)) : '');

      // Achica la imagen a máx. 1600px y la pasa a JPEG
      async function procesarImagen(file: File): Promise<Blob> {
        try {
          const bmp = await createImageBitmap(file);
          const max = 1600;
          const k = Math.min(1, max / Math.max(bmp.width, bmp.height));
          const c = document.createElement('canvas');
          c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
          const ctx = c.getContext('2d')!;
          ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
          ctx.drawImage(bmp, 0, 0, c.width, c.height);
          return await new Promise((res) => c.toBlob((b) => res(b || file), 'image/jpeg', 0.86));
        } catch {
          return file;
        }
      }

      // ---------------------------- Lógica de producto ----------------------------
      function nuevoProducto(): Producto {
        const ahora = Date.now();
        return {
          id: uid(), creado: ahora, actualizado: ahora,
          codigo: '', nombre: '', slug: '', categoria: '', subcategoria: '', precio: '', precioPromo: '', descripcion: '',
          fotos: [], props: [], datos: [], variantes: {},
          stock: '', peso: '', alto: '', ancho: '', profundidad: '', costo: '',
          marca: MARCA_DEFAULT, tags: '', seoTitulo: '', seoDescripcion: '', mostrar: true, envioGratis: false,
        };
      }

      const propsValidas = (p: Producto) => p.props.filter((x) => x.nombre.trim() && lista(x.valores).length).slice(0, MAX_PROPS);

      // Todas las combinaciones de valores de variantes: [['Beige','50x50'], ...]
      function combinaciones(p: Producto): string[][] {
        const ps = propsValidas(p);
        if (!ps.length) return [[]];
        return ps.reduce<string[][]>((acc, pr) => acc.flatMap((c) => lista(pr.valores).map((v) => [...c, v])), [[]]);
      }
      const claveCombo = (c: string[]) => c.join(' | ');
      function skuPorDefecto(p: Producto, combo: string[], i: number, total: number) {
        if (total <= 1) return p.codigo.trim();
        return `${p.codigo.trim()}-${String(i + 1).padStart(2, '0')}`;
      }

      function validar(p: Producto, todos: Producto[]): string[] {
        const e: string[] = [];
        if (!p.codigo.trim()) e.push('Falta el código de producto.');
        if (!p.nombre.trim()) e.push('Falta el nombre.');
        if (!p.categoria.trim()) e.push('Falta la categoría.');
        if (!normalizarPrecio(p.precio)) e.push('Falta el precio (o no es un número).');
        if (p.precioPromo && !normalizarPrecio(p.precioPromo)) e.push('El precio promocional no es un número.');
        if (p.fotos.length < 1) e.push('Cargá al menos 1 foto.');
        if (p.fotos.length > MAX_FOTOS) e.push(`Máximo ${MAX_FOTOS} fotos.`);
        const cod = p.codigo.trim().toLowerCase();
        if (cod && todos.some((o) => o.id !== p.id && o.codigo.trim().toLowerCase() === cod)) e.push('Ya existe otro producto con ese código.');
        const slug = p.slug || slugify(p.nombre);
        if (slug && todos.some((o) => o.id !== p.id && (o.slug || slugify(o.nombre)) === slug)) e.push(`La URL "${slug}" ya la usa otro producto: cambiá el nombre o la URL.`);
        const nombresProps = propsValidas(p).map((x) => x.nombre.trim().toLowerCase());
        if (new Set(nombresProps).size !== nombresProps.length) e.push('Hay dos variantes con el mismo nombre.');
        if (p.props.filter((x) => x.nombre.trim() || x.valores.trim()).some((x) => !x.nombre.trim() || !lista(x.valores).length)) e.push('Hay una variante sin nombre o sin valores.');
        const combos = combinaciones(p).length;
        if (combos > 1000) e.push(`Demasiadas combinaciones (${combos}). Tiendanube admite hasta 1000 variantes.`);
        return e;
      }

      function descripcionHtml(p: Producto): string {
        const partes: string[] = [];
        const texto = p.descripcion.trim();
        if (texto) partes.push(texto.split(/\n{2,}/).map((par) => `<p>${esc(par).replace(/\n/g, '<br>')}</p>`).join(''));
        const datos = p.datos.filter((d) => d.nombre.trim() && d.valor.trim());
        if (datos.length) partes.push('<ul>' + datos.map((d) => `<li><strong>${esc(d.nombre.trim())}:</strong> ${esc(d.valor.trim())}</li>`).join('') + '</ul>');
        return partes.join('');
      }

      // En Tiendanube las categorías se escriben "Categoría > Subcategoría"; las comas y ">" dentro de un nombre se escapan con "\"
      const escCat = (s: string) => s.trim().replace(/\\/g, '\\\\').replace(/,/g, '\\,').replace(/>/g, '\\>');
      function categoriasTN(p: Producto) {
        const cat = escCat(p.categoria);
        return p.subcategoria.trim() ? `${cat} > ${escCat(p.subcategoria)}` : cat;
      }

      // Filas del CSV para un producto (una fila por variante)
      function filasTN(p: Producto): Record<string, string>[] {
        const ps = propsValidas(p);
        const combos = combinaciones(p);
        const slug = p.slug || slugify(p.nombre);
        return combos.map((combo, i) => {
          const v = p.variantes[claveCombo(combo)] || {};
          const f: Record<string, string> = Object.fromEntries(COLUMNAS_TN.map((c) => [c, '']));
          f['Identificador de URL'] = slug;
          ps.forEach((pr, k) => {
            f[`Nombre de propiedad ${k + 1}`] = pr.nombre.trim();
            f[`Valor de propiedad ${k + 1}`] = combo[k];
          });
          f['Precio'] = normalizarPrecio(v.precio || '') || normalizarPrecio(p.precio);
          f['Precio promocional'] = normalizarPrecio(p.precioPromo);
          f['Peso (kg)'] = normalizarPrecio(p.peso);
          f['Alto (cm)'] = normalizarPrecio(p.alto);
          f['Ancho (cm)'] = normalizarPrecio(p.ancho);
          f['Profundidad (cm)'] = normalizarPrecio(p.profundidad);
          f['Stock'] = (v.stock ?? '').trim() || p.stock.trim();
          f['SKU'] = (v.sku ?? '').trim() || skuPorDefecto(p, combo, i, combos.length);
          f['Costo'] = normalizarPrecio(p.costo);
          if (i === 0) {
            // Los datos generales del producto van solo en la primera fila
            f['Nombre'] = p.nombre.trim();
            f['Categorías'] = categoriasTN(p);
            f['Mostrar en tienda'] = p.mostrar ? 'SI' : 'NO';
            f['Envío sin cargo'] = p.envioGratis ? 'SI' : 'NO';
            f['Descripción'] = descripcionHtml(p);
            f['Tags'] = lista(p.tags).join(', ');
            f['Título para SEO'] = p.seoTitulo.trim();
            f['Descripción para SEO'] = p.seoDescripcion.trim();
            f['Marca'] = p.marca.trim();
            f['Producto Físico'] = 'SI';
          }
          return f;
        });
      }

      // ---------------------------- Estado y render de la lista ----------------------------
      let productos: Producto[] = [];

      async function recargar() {
        productos = (await dbTodos()).sort((a, b) => b.actualizado - a.actualizado);
        renderLista();
        renderDatalists();
      }

      function renderLista() {
        const q = slugify(($('#buscador') as HTMLInputElement).value).replace(/-/g, ' ');
        const visibles = productos.filter((p) => !q || slugify(`${p.codigo} ${p.nombre} ${p.categoria} ${p.subcategoria}`).replace(/-/g, ' ').includes(q));
        const completos = productos.filter((p) => !validar(p, productos).length).length;
        $('#resumen').textContent = productos.length
          ? `${productos.length} productos · ${completos} listos para exportar${productos.length - completos ? ` · ${productos.length - completos} incompletos` : ''}`
          : '';
        $('#vacio').hidden = productos.length > 0;
        $('#lista').innerHTML = visibles.map((p) => {
          const errs = validar(p, productos);
          const foto = p.fotos[0];
          const nVar = combinaciones(p).length;
          return `<article class="card" data-id="${p.id}" tabindex="0">
            <div class="img">${foto ? `<img src="${esc(srcFoto(foto))}" alt="" loading="lazy">` : 'Sin foto'}</div>
            <div class="info">
              <span class="cod">${esc(p.codigo || 'sin código')}</span>
              <span class="nom">${esc(p.nombre || 'Sin nombre')}</span>
              <span class="cat">${esc([p.categoria, p.subcategoria].filter(Boolean).join(' › ') || 'Sin categoría')}${nVar > 1 ? ` · ${nVar} variantes` : ''}</span>
              <div class="pie"><strong>${fmtPrecio(p.precio)}</strong>
                ${errs.length ? `<span class="badge warn" title="${esc(errs.join('\n'))}">Incompleto</span>` : '<span class="badge">Listo</span>'}
              </div>
            </div>
          </article>`;
        }).join('');
      }

      function renderDatalists() {
        const cats = [...new Set([...Object.values(NOMBRES_CATEGORIA), ...productos.map((p) => p.categoria.trim())].filter(Boolean))].sort();
        $('#dlCategorias').innerHTML = cats.map((c) => `<option value="${esc(c)}">`).join('');
        const subs = [...new Set(productos.map((p) => p.subcategoria.trim()).filter(Boolean))].sort();
        $('#dlSubcategorias').innerHTML = subs.map((c) => `<option value="${esc(c)}">`).join('');
      }

      // ---------------------------- Formulario ----------------------------
      const dlg = $('#dlg') as HTMLDialogElement;
      const form = $('#form') as HTMLFormElement;
      let editando: Producto = nuevoProducto();
      let slugManual = false;
      const CAMPOS = ['codigo', 'nombre', 'slug', 'categoria', 'subcategoria', 'precio', 'precioPromo', 'descripcion', 'stock', 'peso', 'alto', 'ancho', 'profundidad', 'costo', 'marca', 'tags', 'seoTitulo', 'seoDescripcion'] as const;
      const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

      function abrir(p?: Producto) {
        editando = p ? structuredClone(p) : nuevoProducto();
        slugManual = !!(p && p.slug && p.slug !== slugify(p.nombre));
        $('#dlgTitulo').textContent = p ? 'Editar producto' : 'Nuevo producto';
        $('#btnEliminar').hidden = !p;
        CAMPOS.forEach((c) => (campo(c).value = (editando as any)[c] ?? ''));
        if (!slugManual) campo('slug').value = '';
        campo('slug').placeholder = slugify(editando.nombre) || 'se-genera-con-el-nombre';
        campo('mostrar').checked = editando.mostrar;
        campo('envioGratis').checked = editando.envioGratis;
        $('#errores').hidden = true;
        renderFotos(); renderProps(); renderDatos(); renderVariantes();
        dlg.showModal();
        campo('codigo').focus();
      }

      function leerForm() {
        CAMPOS.forEach((c) => ((editando as any)[c] = campo(c).value));
        editando.slug = slugManual && campo('slug').value.trim() ? slugify(campo('slug').value) : slugify(editando.nombre);
        editando.mostrar = campo('mostrar').checked;
        editando.envioGratis = campo('envioGratis').checked;
      }

      campo('nombre').addEventListener('input', () => { campo('slug').placeholder = slugify(campo('nombre').value) || 'se-genera-con-el-nombre'; });
      campo('slug').addEventListener('input', () => { slugManual = !!campo('slug').value.trim(); });
      campo('codigo').addEventListener('input', () => { editando.codigo = campo('codigo').value; renderVariantes(); });
      campo('precio').addEventListener('input', () => { editando.precio = campo('precio').value; renderVariantes(); });

      // Fotos
      function renderFotos() {
        const cont = $('#fotos');
        const celdas = editando.fotos.map((f, i) => `<div class="foto" data-i="${i}">
            <img src="${esc(srcFoto(f))}" alt="Foto ${i + 1}">
            <span class="n">${i === 0 ? 'Principal' : i + 1}</span>
            <div class="ctrl">
              ${i > 0 ? `<button type="button" data-acc="izq" title="Mover a la izquierda">←</button>` : ''}
              <button type="button" data-acc="quitar" title="Quitar foto">✕</button>
            </div>
          </div>`);
        for (let i = editando.fotos.length; i < MAX_FOTOS; i++) celdas.push(`<div class="foto vacia">Foto ${i + 1}</div>`);
        cont.innerHTML = celdas.join('');
        const lleno = editando.fotos.length >= MAX_FOTOS;
        ($('#inpFotos') as HTMLInputElement).disabled = lleno;
        ($('#inpFotoUrl') as HTMLInputElement).disabled = lleno;
        ($('#btnFotoUrl') as HTMLButtonElement).disabled = lleno;
      }
      $('#fotos').addEventListener('click', (ev) => {
        const b = (ev.target as HTMLElement).closest('button'); if (!b) return;
        const i = Number(b.closest<HTMLElement>('.foto')!.dataset.i);
        if (b.dataset.acc === 'quitar') editando.fotos.splice(i, 1);
        if (b.dataset.acc === 'izq') [editando.fotos[i - 1], editando.fotos[i]] = [editando.fotos[i], editando.fotos[i - 1]];
        renderFotos();
      });
      $('#inpFotos').addEventListener('change', async (ev) => {
        const inp = ev.target as HTMLInputElement;
        const files = [...(inp.files || [])];
        const lugar = MAX_FOTOS - editando.fotos.length;
        if (files.length > lugar) toast(`Solo se agregaron ${lugar} foto(s): el máximo es ${MAX_FOTOS}.`);
        for (const f of files.slice(0, lugar)) editando.fotos.push({ id: uid(), blob: await procesarImagen(f) });
        inp.value = '';
        renderFotos();
      });
      function agregarFotoUrl() {
        const inp = $('#inpFotoUrl') as HTMLInputElement;
        const url = inp.value.trim();
        if (!/^https?:\/\//i.test(url)) { toast('Pegá un link que empiece con http:// o https://'); return; }
        if (editando.fotos.length >= MAX_FOTOS) return;
        editando.fotos.push({ id: uid(), url });
        inp.value = '';
        renderFotos();
      }
      $('#btnFotoUrl').addEventListener('click', agregarFotoUrl);
      $('#inpFotoUrl').addEventListener('keydown', (ev) => { if ((ev as KeyboardEvent).key === 'Enter') { ev.preventDefault(); agregarFotoUrl(); } });

      // Variantes (propiedades)
      function renderProps() {
        $('#props').innerHTML = editando.props.map((pr, i) => `<div class="fila" data-i="${i}">
            <input data-k="nombre" value="${esc(pr.nombre)}" placeholder="Ej: Color" list="dlPropNombres">
            <input data-k="valores" value="${esc(pr.valores)}" placeholder="Ej: Beige, Blanco, Gris">
            <button type="button" class="quitar" title="Quitar">✕</button>
          </div>`).join('') + `<datalist id="dlPropNombres"><option value="Color"><option value="Medida"><option value="Tamaño"><option value="Tipo"><option value="Diseño"><option value="Tela"></datalist>`;
        ($('#btnAddProp') as HTMLButtonElement).hidden = editando.props.length >= MAX_PROPS;
      }
      $('#btnAddProp').addEventListener('click', () => {
        if (editando.props.length < MAX_PROPS) editando.props.push({ nombre: '', valores: '' });
        renderProps();
        ($('#props .fila:last-of-type input') as HTMLInputElement)?.focus();
      });
      $('#props').addEventListener('input', (ev) => {
        const inp = ev.target as HTMLInputElement;
        const i = Number(inp.closest<HTMLElement>('.fila')!.dataset.i);
        (editando.props[i] as any)[inp.dataset.k!] = inp.value;
        renderVariantes();
      });
      $('#props').addEventListener('click', (ev) => {
        const b = (ev.target as HTMLElement).closest('.quitar'); if (!b) return;
        editando.props.splice(Number(b.closest<HTMLElement>('.fila')!.dataset.i), 1);
        renderProps(); renderVariantes();
      });

      function renderVariantes() {
        const ps = propsValidas(editando);
        const combos = combinaciones(editando);
        const wrap = $('#variantesWrap');
        wrap.hidden = !ps.length;
        if (!ps.length) return;
        if (combos.length > 300) {
          $('#tablaVariantes').innerHTML = `<tr><td>${combos.length} combinaciones (demasiadas para mostrar). Todas usan el precio, stock y SKU automáticos.</td></tr>`;
          return;
        }
        const precioBase = normalizarPrecio(campo('precio').value);
        $('#tablaVariantes').innerHTML = `<thead><tr>${ps.map((p) => `<th>${esc(p.nombre)}</th>`).join('')}<th>Precio</th><th>Stock</th><th>SKU</th></tr></thead><tbody>` +
          combos.map((c, i) => {
            const k = claveCombo(c);
            const v = editando.variantes[k] || {};
            return `<tr data-k="${esc(k)}">${c.map((x) => `<td>${esc(x)}</td>`).join('')}
              <td><input data-c="precio" value="${esc(v.precio || '')}" placeholder="${esc(precioBase || 'precio')}" inputmode="decimal"></td>
              <td><input data-c="stock" value="${esc(v.stock || '')}" placeholder="${esc(campo('stock').value || '∞')}" inputmode="numeric"></td>
              <td><input data-c="sku" value="${esc(v.sku || '')}" placeholder="${esc(skuPorDefecto({ ...editando, codigo: campo('codigo').value }, c, i, combos.length) || 'SKU')}"></td>
            </tr>`;
          }).join('') + '</tbody>';
      }
      $('#tablaVariantes').addEventListener('input', (ev) => {
        const inp = ev.target as HTMLInputElement;
        const k = inp.closest('tr')!.dataset.k!;
        editando.variantes[k] = { ...(editando.variantes[k] || {}), [inp.dataset.c!]: inp.value };
      });

      // Otros datos
      function renderDatos() {
        $('#datos').innerHTML = editando.datos.map((d, i) => `<div class="fila" data-i="${i}">
            <input data-k="nombre" value="${esc(d.nombre)}" placeholder="Ej: Tela" list="dlDatoNombres">
            <input data-k="valor" value="${esc(d.valor)}" placeholder="Ej: Lino">
            <button type="button" class="quitar" title="Quitar">✕</button>
          </div>`).join('') + `<datalist id="dlDatoNombres"><option value="Tela"><option value="Material"><option value="Medidas"><option value="Relleno"><option value="Cuidados"><option value="Terminación"></datalist>`;
      }
      $('#btnAddDato').addEventListener('click', () => {
        editando.datos.push({ nombre: '', valor: '' });
        renderDatos();
        ($('#datos .fila:last-of-type input') as HTMLInputElement)?.focus();
      });
      $('#datos').addEventListener('input', (ev) => {
        const inp = ev.target as HTMLInputElement;
        (editando.datos[Number(inp.closest<HTMLElement>('.fila')!.dataset.i)] as any)[inp.dataset.k!] = inp.value;
      });
      $('#datos').addEventListener('click', (ev) => {
        const b = (ev.target as HTMLElement).closest('.quitar'); if (!b) return;
        editando.datos.splice(Number(b.closest<HTMLElement>('.fila')!.dataset.i), 1);
        renderDatos();
      });

      // Guardar / cerrar / eliminar
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        leerForm();
        // limpiar filas vacías
        editando.props = editando.props.filter((x) => x.nombre.trim() || x.valores.trim());
        editando.datos = editando.datos.filter((x) => x.nombre.trim() || x.valor.trim());
        const validas = new Set(combinaciones(editando).map(claveCombo));
        editando.variantes = Object.fromEntries(Object.entries(editando.variantes).filter(([k, v]) => validas.has(k) && (v.precio || v.stock || v.sku)));
        const errs = validar(editando, productos);
        const bloqueantes = errs.filter((e) => /código|URL|mismo nombre|sin nombre|Demasiadas|Máximo/.test(e) && !/Falta el código/.test(e));
        if (bloqueantes.length) {
          const ul = $('#errores');
          ul.innerHTML = bloqueantes.map((e) => `<li>${esc(e)}</li>`).join('');
          ul.hidden = false; ul.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }
        editando.actualizado = Date.now();
        await dbGuardar(editando);
        dlg.close();
        await recargar();
        toast(errs.length ? `Guardado, pero está incompleto:\n• ${errs.join('\n• ')}` : 'Producto guardado ✓', errs.length ? 6000 : 2500);
      });
      $('#btnCerrar').addEventListener('click', () => dlg.close());
      $('#btnCancelar').addEventListener('click', () => dlg.close());
      $('#btnEliminar').addEventListener('click', async () => {
        if (!confirm(`¿Eliminar "${editando.nombre || editando.codigo}"?`)) return;
        await dbBorrar(editando.id);
        dlg.close();
        await recargar();
        toast('Producto eliminado');
      });

      $('#btnNuevo').addEventListener('click', () => abrir());
      $('#lista').addEventListener('click', (ev) => {
        const c = (ev.target as HTMLElement).closest<HTMLElement>('.card');
        if (c) abrir(productos.find((p) => p.id === c.dataset.id));
      });
      $('#lista').addEventListener('keydown', (ev) => {
        const c = (ev.target as HTMLElement).closest<HTMLElement>('.card');
        if (c && (ev as KeyboardEvent).key === 'Enter') abrir(productos.find((p) => p.id === c.dataset.id));
      });
      $('#buscador').addEventListener('input', renderLista);

      // ---------------------------- Exportar ----------------------------
      function preparaExport(): { listos: Producto[]; filas: Record<string, string>[] } | null {
        if (!productos.length) { toast('No hay productos para exportar.'); return null; }
        const listos = productos.filter((p) => !validar(p, productos).length).sort((a, b) => a.creado - b.creado);
        const incompletos = productos.length - listos.length;
        if (!listos.length) { toast('Ningún producto está completo todavía (código, nombre, categoría, precio y al menos 1 foto).', 6000); return null; }
        if (incompletos && !confirm(`Hay ${incompletos} producto(s) incompletos que NO se van a exportar (marcados como "Incompleto").\n\n¿Exportar los ${listos.length} que están listos?`)) return null;
        return { listos, filas: listos.flatMap(filasTN) };
      }

      function csv(filas: Record<string, string>[], sep: string) {
        const celda = (v: string) => {
          const s = String(v ?? '');
          return /["\r\n]/.test(s) || s.includes(sep) || /^\s|\s$/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
        };
        return [COLUMNAS_TN, ...filas.map((f) => COLUMNAS_TN.map((c) => f[c]))].map((r) => r.map(celda).join(sep)).join('\r\n') + '\r\n';
      }

      $('#btnExportCsv').addEventListener('click', () => {
        const r = preparaExport(); if (!r) return;
        const sep = ($('#selSeparador') as HTMLSelectElement).value;
        descargar(new Blob([csv(r.filas, sep)], { type: 'text/csv;charset=utf-8' }), `tiendanube-productos-${fecha()}.csv`);
        toast(`CSV listo: ${r.listos.length} productos (${r.filas.length} filas).`);
      });

      const nombreArchivoFoto = (p: Producto, i: number, f: Foto) => {
        const ext = f.blob ? (f.blob.type.split('/')[1] || 'jpg').replace('jpeg', 'jpg') : ((f.url || '').match(/\.(jpe?g|png|webp|gif)(\?|$)/i)?.[1] || 'jpg');
        return `${slugify(p.codigo) || p.slug}-${i + 1}.${ext.toLowerCase()}`;
      };

      $('#btnExportXlsx').addEventListener('click', () => {
        if (typeof XLSX === 'undefined') { toast('No se pudo cargar la librería de Excel. Revisá la conexión a internet.'); return; }
        const r = preparaExport(); if (!r) return;
        const wb = XLSX.utils.book_new();
        const hoja = XLSX.utils.json_to_sheet(r.filas, { header: COLUMNAS_TN });
        hoja['!cols'] = COLUMNAS_TN.map((c) => ({ wch: Math.min(40, Math.max(10, c.length + 2)) }));
        XLSX.utils.book_append_sheet(wb, hoja, 'Tiendanube');
        const fotos = r.listos.flatMap((p) => p.fotos.map((f, i) => ({
          'Código': p.codigo, 'Identificador de URL': p.slug || slugify(p.nombre), 'Nombre': p.nombre, 'N° foto': i + 1,
          'Archivo (en el ZIP)': nombreArchivoFoto(p, i, f), 'Link': f.url || '',
        })));
        const hf = XLSX.utils.json_to_sheet(fotos);
        hf['!cols'] = [{ wch: 16 }, { wch: 30 }, { wch: 30 }, { wch: 8 }, { wch: 26 }, { wch: 60 }];
        XLSX.utils.book_append_sheet(wb, hf, 'Fotos');
        XLSX.writeFile(wb, `tiendanube-productos-${fecha()}.xlsx`);
        toast('Excel listo. Para importar en Tiendanube usá el CSV (Tiendanube no acepta .xlsx).', 6000);
      });

      $('#btnExportFotos').addEventListener('click', async (ev) => {
        if (typeof JSZip === 'undefined') { toast('No se pudo cargar la librería ZIP. Revisá la conexión a internet.'); return; }
        const listos = productos.filter((p) => p.fotos.length);
        if (!listos.length) { toast('No hay fotos cargadas.'); return; }
        const btn = ev.currentTarget as HTMLButtonElement;
        btn.disabled = true; const txt = btn.textContent; btn.textContent = 'Armando ZIP…';
        try {
          const zip = new JSZip();
          const faltan: string[] = [];
          for (const p of listos) {
            const carpeta = zip.folder(slugify(p.codigo) || p.slug || p.id);
            for (const [i, f] of p.fotos.entries()) {
              const nombre = nombreArchivoFoto(p, i, f);
              if (f.blob) { carpeta.file(nombre, f.blob); continue; }
              try {
                const res = await fetch(f.url!, { mode: 'cors' });
                if (!res.ok) throw new Error(String(res.status));
                carpeta.file(nombre, await res.blob());
              } catch {
                faltan.push(`${nombre}\t${f.url}`);
              }
            }
          }
          if (faltan.length) zip.file('fotos-para-descargar-a-mano.txt', 'Estas fotos son links y no se pudieron bajar automáticamente:\n\n' + faltan.join('\n') + '\n');
          descargar(await zip.generateAsync({ type: 'blob' }), `fotos-productos-${fecha()}.zip`);
          toast(faltan.length ? `ZIP listo. ${faltan.length} foto(s) por link quedaron listadas en un .txt dentro del ZIP.` : 'ZIP de fotos listo ✓', 6000);
        } finally {
          btn.disabled = false; btn.textContent = txt;
        }
      });

      // ---------------------------- Respaldo ----------------------------
      const blobADataUrl = (b: Blob) => new Promise<string>((res) => { const r = new FileReader(); r.onload = () => res(String(r.result)); r.readAsDataURL(b); });
      const dataUrlABlob = async (d: string) => (await fetch(d)).blob();

      $('#btnBackup').addEventListener('click', async () => {
        const datos = await Promise.all(productos.map(async (p) => ({
          ...p, fotos: await Promise.all(p.fotos.map(async (f) => (f.blob ? { id: f.id, data: await blobADataUrl(f.blob) } : { id: f.id, url: f.url }))),
        })));
        descargar(new Blob([JSON.stringify({ app: 'bonte-cargador', version: 1, productos: datos })], { type: 'application/json' }), `respaldo-productos-${fecha()}.json`);
        toast('Respaldo descargado. Guardalo: con él podés recuperar todo en otra compu.');
      });
      $('#inpBackup').addEventListener('change', async (ev) => {
        const inp = ev.target as HTMLInputElement;
        const file = inp.files?.[0]; inp.value = '';
        if (!file) return;
        try {
          const json = JSON.parse(await file.text());
          if (json.app !== 'bonte-cargador' || !Array.isArray(json.productos)) throw new Error('formato');
          const ps: Producto[] = await Promise.all(json.productos.map(async (p: any) => ({
            ...nuevoProducto(), ...p,
            fotos: await Promise.all((p.fotos || []).map(async (f: any) => (f.data ? { id: f.id, blob: await dataUrlABlob(f.data) } : { id: f.id, url: f.url }))),
          })));
          if (!confirm(`Restaurar ${ps.length} productos? Los que tengan el mismo id se reemplazan.`)) return;
          await dbGuardarVarios(ps);
          await recargar();
          toast(`Se restauraron ${ps.length} productos ✓`);
        } catch {
          toast('Ese archivo no es un respaldo válido del cargador.');
        }
      });

      $('#btnBorrarTodo').addEventListener('click', async () => {
        if (!productos.length) return;
        if (!confirm(`¿Borrar los ${productos.length} productos cargados en este navegador? Te conviene descargar un respaldo antes.`)) return;
        if (!confirm('Seguro? Esto no se puede deshacer.')) return;
        await dbBorrarTodo();
        await recargar();
        toast('Se borraron todos los productos');
      });

      // ---------------------------- Importar catálogo actual ----------------------------
      $('#btnImportCatalogo').addEventListener('click', async () => {
        try {
          const res = await fetch('/productos.json');
          const viejos: any[] = await res.json();
          const existentes = new Set(productos.map((p) => p.slug));
          const nuevos = viejos.filter((v) => !existentes.has(slugify(v.nombre)));
          if (!nuevos.length) { toast('Los productos del catálogo ya están cargados.'); return; }
          if (!confirm(`Se van a traer ${nuevos.length} productos del catálogo actual con sus fotos, variantes y datos.\n\nVas a tener que completar el CÓDIGO y el PRECIO de cada uno.`)) return;
          const base = Date.now();
          const ps = nuevos.map((v, idx): Producto => {
            const p = nuevoProducto();
            p.creado = base + idx; p.actualizado = base - idx;
            p.nombre = String(v.titulo || '').trim();
            p.slug = slugify(v.nombre || v.titulo);
            p.categoria = NOMBRES_CATEGORIA[v.categoria] || v.categoria.charAt(0).toUpperCase() + v.categoria.slice(1);
            const sub = String(v.nombreCategoria || '').trim();
            p.subcategoria = sub && !sub.includes('-') && sub.toLowerCase() !== p.categoria.toLowerCase() ? sub : '';
            const urls = [v.imagen1, v.imagen2, v.imagen3, v.imagen4, v.imagen5].map((u) => String(u || '').trim()).filter(Boolean);
            p.fotos = [...new Set(urls)].slice(0, MAX_FOTOS).map((url) => ({ id: uid(), url }));
            const candidatos: Prop[] = [
              { nombre: 'Color', valores: v.color }, { nombre: 'Medida', valores: v['tamaño'] },
              { nombre: 'Tipo', valores: v.tipo }, { nombre: 'Diseño', valores: v['diseño'] },
            ].filter((x) => lista(x.valores).length);
            p.props = candidatos.slice(0, MAX_PROPS).map((x) => ({ nombre: x.nombre, valores: lista(x.valores).join(', ') }));
            candidatos.slice(MAX_PROPS).forEach((x) => p.datos.push({ nombre: x.nombre, valor: x.valores }));
            if (String(v.tela || '').trim()) p.datos.unshift({ nombre: 'Tela', valor: String(v.tela).trim() });
            p.descripcion = [v.descripcion, v.descripcion2].map((d) => String(d || '').trim()).filter(Boolean).join('\n\n');
            return p;
          });
          await dbGuardarVarios(ps);
          await recargar();
          toast(`Se trajeron ${ps.length} productos. Completá código y precio de cada uno.`, 6000);
        } catch {
          toast('No se pudo leer el catálogo actual (productos.json).');
        }
      });

      // El menú "Más…" se cierra al elegir una opción o al hacer clic afuera
      const menu = $('.menu') as HTMLDetailsElement;
      menu.addEventListener('click', (ev) => { if ((ev.target as HTMLElement).closest('button.link')) menu.open = false; });
      $('#inpBackup').addEventListener('click', () => (menu.open = false));
      document.addEventListener('click', (ev) => { if (!menu.contains(ev.target as Node)) menu.open = false; });

      // ---------------------------- Inicio ----------------------------
      try {
        const s = localStorage.getItem('bonte-cargador-sep');
        if (s) ($('#selSeparador') as HTMLSelectElement).value = s;
      } catch {}
      $('#selSeparador').addEventListener('change', (ev) => {
        try { localStorage.setItem('bonte-cargador-sep', (ev.target as HTMLSelectElement).value); } catch {}
      });
      recargar().catch(() => toast('Este navegador no permite guardar datos (¿modo incógnito?).', 8000));
    </script>
  </body>
</html>
