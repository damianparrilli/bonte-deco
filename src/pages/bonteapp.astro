      // ================================================================
      // Alta / Modificación / Baja de producto
      // ================================================================
      const dlg = $('#dlg') as HTMLDialogElement;
      const form = $('#form') as HTMLFormElement;
      const CAMPOS = ['nombre', 'tela', 'categoria', 'subcategoria', 'descripcion', 'peso', 'alto', 'ancho', 'profundidad'] as const;
