      function renderVariantes() {
        $('#tablaVar tbody').innerHTML = editando.variantes.map((v, i) => `<tr data-i="${i}">
          <td><input class="cod" data-k="codigo" value="${esc(v.codigo)}" placeholder="auto"></td>
