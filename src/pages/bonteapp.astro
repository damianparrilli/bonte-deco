          <td><input data-k="detalle" value="${esc(v.detalle)}"></td>
          <td><input class="precio" data-k="efectivo" inputmode="decimal" value="${esc(textoPrecio(v.efectivo))}"></td>
          <td><input class="precio" data-k="lista" inputmode="decimal" value="${esc(textoPrecio(v.lista))}" placeholder="${esc(textoPrecio(listaAuto(v.efectivo)))}"></td>
          <td><input class="oferta" data-k="oferta" value="${esc(v.oferta)}" placeholder="Ej: 2 x 65000"></td>
