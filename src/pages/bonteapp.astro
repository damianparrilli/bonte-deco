---
// Bonté App: ABM de productos + lista de precios + importar/exportar
// (formato simple y formato de importación de Tiendanube).
// Los datos, usuarios y fotos viven en Supabase (ver src/lib/supabase.ts y
// supabase/instalar.sql). Solo los emails de la tabla "admins" pueden editar.
import listaInicial from '../data/lista-precios.json';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Bonté App</title>
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>window.__bonteHash = location.hash;</script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  </head>
  <body class="sin-sesion">
    <header class="top">
      <div class="wrap top-inner">
        <a href="/bonteapp" class="marca"><img src="/logo.svg" alt="" width="64" height="26" /><span>App</span></a>
        <nav class="tabs" role="group" aria-label="Secciones">
          <button type="button" class="tab" data-tab="productos" aria-pressed="true">Productos</button>
          <button type="button" class="tab" data-tab="precios" aria-pressed="false">Lista de precios</button>
          <button type="button" class="tab" data-tab="io" aria-pressed="false">Importar / Exportar</button>
        </nav>
        <button type="button" id="btnNuevo" class="btn primary">+ Nuevo producto</button>
        <div class="usuario">
          <span id="estado" class="muted small" aria-live="polite"></span>
          <button type="button" id="btnRecargar" class="btn small" title="Traer los últimos cambios">↻</button>
          <button type="button" id="btnSalir" class="btn small" title="">Salir</button>
        </div>
      </div>
    </header>

    <!-- Login -->
    <section id="acceso" class="acceso" hidden>
      <form id="formLogin" class="acceso-card">
        <img src="/logo.svg" alt="Bonté" width="120" height="50" class="acceso-logo" />
        <h1>Ingresar</h1>
        <label>Email <input type="email" name="email" required autocomplete="username" /></label>
        <label>Contraseña <input type="password" name="password" required autocomplete="current-password" /></label>
        <button type="submit" class="btn primary">Ingresar</button>
        <button type="button" class="link" id="btnOlvide">Olvidé mi contraseña</button>
        <p id="loginMsg" class="msg" hidden></p>
      </form>
      <form id="formClave" class="acceso-card" hidden>
        <h1>Elegí tu contraseña</h1>
        <p class="muted small" id="claveEmail"></p>
        <label>Nueva contraseña <input type="password" name="clave" minlength="8" required autocomplete="new-password" /></label>
        <label>Repetila <input type="password" name="clave2" minlength="8" required autocomplete="new-password" /></label>
        <button type="submit" class="btn primary">Guardar contraseña</button>
        <p id="claveMsg" class="msg" hidden></p>
      </form>
      <div id="noAutorizado" class="acceso-card" hidden>
        <h1>Sin permiso</h1>
        <p>El usuario <strong id="naEmail"></strong> no está autorizado para editar productos.</p>
        <p class="muted small">Pedile al administrador que agregue tu email en la tabla <em>admins</em> de Supabase.</p>
        <button type="button" class="btn" id="btnSalir2">Salir</button>
      </div>
      <p id="cargando" class="muted">Cargando…</p>
    </section>

    <main class="wrap">
      <!-- Filtros compartidos por Productos y Lista de precios -->
      <section class="filtros" id="filtros">
        <input type="search" id="buscador" placeholder="Buscar por nombre, código, tela, color o medida…" autocomplete="off" />
        <select id="filtroCat" aria-label="Categoría"><option value="">Todas las categorías</option></select>
        <select id="filtroEstado" aria-label="Estado">
          <option value="">Todos</option>
          <option value="sinprecio">Sin precio</option>
          <option value="sinfoto">Sin foto</option>
          <option value="oculto">No publicados</option>
          <option value="problemas">Con problemas</option>
        </select>
        <span id="resumen" class="muted small"></span>
      </section>

      <!-- PRODUCTOS -->
      <section id="tab-productos" class="panel">
        <div id="listaProductos" class="lista"></div>
      </section>

      <!-- LISTA DE PRECIOS -->
      <section id="tab-precios" class="panel" hidden>
        <div class="barra">
          <p class="muted small">Editá los precios directo en la tabla: se guardan solos. La lista se calcula como efectivo + <strong id="txtRecargo">20</strong>% salvo que escribas un valor propio.</p>
          <div class="barra-acc">
            <button type="button" class="btn small" id="btnAumento">Aumentar precios…</button>
            <a class="btn small" href="/precios" target="_blank" rel="noopener">Ver lista online ↗</a>
          </div>
        </div>
        <div class="tabla-scroll">
          <table class="tabla" id="tablaPrecios">
            <thead>
              <tr>
                <th>Código</th><th>Producto</th><th>Color</th><th>Medida</th><th>Detalle</th>
                <th class="num">Efectivo / transf.</th><th class="num">Lista</th><th>Oferta</th><th title="Publicar">Pub.</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- IMPORTAR / EXPORTAR -->
      <section id="tab-io" class="panel" hidden>
        <div class="cards">
          <article class="card-io">
            <h2>Importar lista de precios</h2>
            <p class="muted">Excel (.xlsx) o CSV con el <strong>formato simple</strong>: una fila por código. Columnas: Código, Categoría, Producto, Tela / material, Color, Medida, Detalle, Efectivo / transferencia, Precio lista, Oferta, Publicar (y opcionales: Subcategoría, Descripción, Stock, Foto 1–4, Peso). Sirve también el Excel de la lista ordenada.</p>
            <label class="radio"><input type="radio" name="modoImport" value="actualizar" checked /> <span><strong>Actualizar por código</strong>: los códigos que ya existen se actualizan y los nuevos se agregan. No se borra nada.</span></label>
            <label class="radio"><input type="radio" name="modoImport" value="reemplazar" /> <span><strong>Reemplazar todo</strong>: borra los productos actuales (y sus fotos) y deja solo los del archivo.</span></label>
            <div class="acc">
              <label class="btn primary">Elegir archivo…<input type="file" id="inpImport" accept=".xlsx,.xls,.csv,text/csv" hidden /></label>
              <button type="button" class="btn" id="btnPlantilla">Descargar plantilla vacía</button>
            </div>
          </article>

          <article class="card-io">
            <h2>Exportar lista de precios</h2>
            <p class="muted">Mismo formato simple, para guardar, editar en Excel o pegar en la planilla de Google que alimenta la lista online.</p>
            <div class="acc">
              <button type="button" class="btn primary" id="btnExpXlsx">Excel (.xlsx)</button>
              <button type="button" class="btn" id="btnExpCsv">CSV</button>
            </div>
          </article>

          <article class="card-io">
            <h2>Exportar para Tiendanube</h2>
            <p class="muted">CSV con el formato de importación masiva de Tiendanube. Cada producto sale con sus variantes (Color, Medida, Modelo) y el código como SKU. Las fotos no viajan en el CSV: subilas aparte (ZIP abajo).</p>
            <div class="grid2">
              <label>Precio en Tiendanube
                <select id="tnPrecio">
                  <option value="lista">Precio de lista (recomendado)</option>
                  <option value="efectivo">Precio efectivo / transferencia</option>
                </select>
              </label>
              <label>Separador
                <select id="tnSep"><option value=",">Coma ( , )</option><option value=";">Punto y coma ( ; )</option></select>
              </label>
            </div>
            <label class="check"><input type="checkbox" id="tnOfertas" /> Usar las ofertas con precio como "Precio promocional"</label>
            <label class="check"><input type="checkbox" id="tnSoloPub" checked /> Solo productos y variantes publicados</label>
            <p class="muted small" id="tnTip"></p>
            <div class="acc">
              <button type="button" class="btn primary" id="btnExpTn">Descargar CSV Tiendanube</button>
              <button type="button" class="btn" id="btnExpFotos">Fotos (ZIP)</button>
            </div>
          </article>

          <article class="card-io">
            <h2>Respaldo</h2>
            <p class="muted">Todo queda guardado en la base de datos online. Igual conviene bajar un respaldo cada tanto (las fotos van como links).</p>
            <div class="acc">
              <button type="button" class="btn primary" id="btnBackup">Descargar respaldo</button>
              <label class="btn">Restaurar respaldo…<input type="file" id="inpBackup" accept=".json,application/json" hidden /></label>
            </div>
          </article>

          <article class="card-io">
            <h2>Configuración</h2>
            <label>Recargo del precio de lista sobre efectivo (%)
              <input type="number" id="cfgRecargo" min="0" step="0.5" value="20" />
            </label>
            <div class="acc">
              <button type="button" class="btn" id="btnSeed">Cargar lista de precios {listaInicial.actualizado}</button>
              <button type="button" class="btn danger-outline" id="btnBorrarTodo">Borrar todo</button>
            </div>
          </article>
        </div>
      </section>

      <p id="vacio" class="vacio" hidden>
        Todavía no hay productos cargados.<br />
        <button type="button" class="btn primary" id="btnSeed2">Cargar la lista de precios {listaInicial.actualizado}</button>
        <span class="muted small">o importá un Excel desde <em>Importar / Exportar</em>.</span>
      </p>
    </main>

    <!-- Diálogo de producto -->
    <dialog id="dlg">
      <form id="form" method="dialog" novalidate>
        <div class="dlg-head">
          <h2 id="dlgTitulo">Nuevo producto</h2>
          <button type="button" class="x" id="btnCerrar" aria-label="Cerrar">×</button>
        </div>
        <div class="dlg-body">
          <div class="grid2">
            <label>Nombre del producto *
              <input name="nombre" required placeholder="Ej: Almohadón Cleo Premium" autocomplete="off" />
            </label>
            <label>Tela / material
              <input name="tela" list="dlTelas" placeholder="Ej: Gasa" autocomplete="off" />
            </label>
            <label>Categoría *
              <input name="categoria" required list="dlCategorias" placeholder="Ej: Almohadones" autocomplete="off" />
            </label>
            <label>Subcategoría <span class="muted">(opcional, para Tiendanube)</span>
              <input name="subcategoria" list="dlSubcategorias" autocomplete="off" />
            </label>
          </div>

          <fieldset>
            <legend>Variantes y precios * <span class="muted">(una fila por código: medida, color o modelo)</span></legend>
            <div class="tabla-scroll">
              <table class="tabla var" id="tablaVar">
                <thead><tr><th>Código</th><th>Color</th><th>Medida</th><th>Modelo / detalle</th><th class="num">Efectivo</th><th class="num">Lista</th><th>Oferta</th><th>Stock</th><th title="Publicar">Pub.</th><th></th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
            <div class="acc">
              <button type="button" class="btn small" id="btnAddVar">+ Agregar variante</button>
              <span class="muted small">Código vacío = se genera solo. Lista vacía = efectivo + recargo. Stock vacío = sin límite.</span>
            </div>
          </fieldset>

          <fieldset>
            <legend>Fotos <span class="muted">(1 a 4, la primera es la principal)</span></legend>
            <div id="fotos" class="fotos"></div>
            <div class="acc">
              <label class="btn small">Subir fotos<input type="file" id="inpFotos" accept="image/*" multiple hidden /></label>
              <input type="url" id="inpFotoUrl" placeholder="…o pegá el link de una foto" />
              <button type="button" class="btn small" id="btnFotoUrl">Agregar link</button>
            </div>
          </fieldset>

          <label>Descripción
            <textarea name="descripcion" rows="3" placeholder="Para Tiendanube: cómo es, cuidados, etc."></textarea>
          </label>

          <details class="extra">
            <summary>Envío (opcional, para calcular costos en Tiendanube)</summary>
            <div class="grid4">
              <label>Peso (kg) <input name="peso" inputmode="decimal" /></label>
              <label>Alto (cm) <input name="alto" inputmode="decimal" /></label>
              <label>Ancho (cm) <input name="ancho" inputmode="decimal" /></label>
              <label>Profundidad (cm) <input name="profundidad" inputmode="decimal" /></label>
            </div>
          </details>

          <ul id="errores" class="errores" hidden></ul>
        </div>
        <div class="dlg-foot">
          <button type="button" class="btn danger-outline" id="btnEliminar">Eliminar</button>
          <button type="button" class="btn" id="btnDuplicar">Duplicar</button>
          <span class="grow"></span>
          <button type="button" class="btn" id="btnCancelar">Cancelar</button>
          <button type="submit" class="btn primary">Guardar</button>
        </div>
      </form>
    </dialog>

    <!-- Diálogo de aumento masivo -->
    <dialog id="dlgAumento" class="chico">
      <form method="dialog" id="formAumento">
        <div class="dlg-head"><h2>Aumentar precios</h2></div>
        <div class="dlg-body">
          <p id="aumAlcance" class="muted"></p>
          <div class="grid2">
            <label>Porcentaje (%) <input type="number" id="aumPct" step="0.1" value="10" /></label>
            <label>Redondear a
              <select id="aumRedondeo"><option value="100">$100</option><option value="500">$500</option><option value="1000">$1.000</option><option value="1">Sin redondeo</option></select>
            </label>
          </div>
          <label class="check"><input type="checkbox" id="aumOfertas" checked /> También las ofertas con precio y las listas escritas a mano</label>
          <p class="muted small">Usá un número negativo para bajar precios. Te conviene descargar un respaldo antes.</p>
        </div>
        <div class="dlg-foot"><span class="grow"></span><button type="button" class="btn" id="aumCancelar">Cancelar</button><button type="submit" class="btn primary">Aplicar</button></div>
      </form>
    </dialog>

    <datalist id="dlCategorias"></datalist>
    <datalist id="dlSubcategorias"></datalist>
    <datalist id="dlTelas"></datalist>
    <div id="toast" class="toast" hidden></div>
    <script is:inline type="application/json" id="seedDatos" set:html={JSON.stringify(listaInicial)} />

    <style is:global>
      :root { --bg: #faf9f7; --card: #fff; --ink: #3c2c0b; --muted: #7a6a4f; --line: #e6dfd2; --brand: #5f4d27; --soft: #f3f0eb; --danger: #b3261e; --ok: #2e7d32; --warn: #9a5b00; }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      .wrap { max-width: 1280px; margin: 0 auto; padding: 0 16px; }
      h2 { font-size: 1.1rem; margin: 0; }
      .muted { color: var(--muted); font-weight: 400; }
      .small { font-size: .84rem; }
      .top { background: var(--card); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
      .top-inner { display: flex; gap: 12px 18px; align-items: center; flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; }
      body.sin-sesion .tabs, body.sin-sesion #btnNuevo, body.sin-sesion .usuario, body.sin-sesion main { display: none !important; }
      .usuario { display: flex; gap: 6px; align-items: center; }
      .acceso { min-height: calc(100dvh - 70px); display: grid; place-items: center; padding: 24px 16px; }
      .acceso-card { width: min(380px, 100%); background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 24px; display: flex; flex-direction: column; gap: 14px; }
      .acceso-card h1 { margin: 0; font-size: 1.3rem; }
      .acceso-card p { margin: 0; }
      .acceso-logo { filter: brightness(0) opacity(.72); align-self: center; height: auto; }
      .link { background: none; border: 0; color: var(--muted); font: inherit; font-size: .85rem; cursor: pointer; text-decoration: underline; padding: 0; align-self: center; }
      .msg { font-size: .88rem; padding: 8px 10px; border-radius: 8px; background: #fdecea; color: var(--danger); }
      .msg.ok { background: #e8f3e8; color: var(--ok); }
      .marca img { filter: brightness(0) opacity(.72); }
      .marca { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; }
      .tabs { display: flex; gap: 4px; flex: 1; overflow-x: auto; }
      .tab { border: 0; background: none; font: inherit; padding: 8px 12px; border-radius: 8px; cursor: pointer; color: var(--muted); white-space: nowrap; }
      .tab:hover { background: var(--soft); }
      .tab[aria-pressed="true"] { background: var(--soft); color: var(--ink); font-weight: 600; }
      .btn { appearance: none; border: 1px solid var(--line); background: var(--card); color: var(--ink); padding: 8px 14px; border-radius: 8px; cursor: pointer; font: inherit; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; white-space: nowrap; }
      .btn:hover { border-color: var(--brand); }
      .btn.primary { background: var(--brand); border-color: var(--brand); color: #fff; }
      .btn.small { padding: 5px 10px; font-size: .85rem; }
      .btn.danger-outline { color: var(--danger); border-color: #e7b7b3; }
      .btn:disabled { opacity: .5; cursor: progress; }
      input, select, textarea { font: inherit; color: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; background: #fff; width: 100%; }
      input:focus, select:focus, textarea:focus { outline: 2px solid rgba(95, 77, 39, .25); border-color: var(--brand); }
      label { display: flex; flex-direction: column; gap: 4px; font-weight: 500; font-size: .9rem; }
      .filtros { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: 16px 0 12px; }
      .filtros input { flex: 1 1 280px; }
      .filtros select { width: auto; }
      .panel { padding-bottom: 60px; }
      .lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; cursor: pointer; display: flex; flex-direction: column; text-align: left; font: inherit; color: inherit; padding: 0; }
      .card:hover, .card:focus-visible { border-color: var(--brand); }
      .card .img { aspect-ratio: 4 / 3; background: var(--soft); position: relative; overflow: hidden; display: grid; place-items: center; color: var(--muted); font-size: .8rem; }
      .card .img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .card .info { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 2px; width: 100%; }
      .card .nom { font-weight: 600; }
      .card .cat { font-size: .8rem; color: var(--muted); }
      .card .pie { display: flex; justify-content: space-between; align-items: center; gap: 6px; margin-top: 6px; font-size: .85rem; flex-wrap: wrap; }
      .badges { display: flex; gap: 4px; flex-wrap: wrap; }
      .badge { font-size: .7rem; padding: 2px 8px; border-radius: 999px; background: #fdf0dc; color: var(--warn); }
      .badge.gris { background: #eee; color: #666; }
      .barra { display: flex; justify-content: space-between; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }
      .barra p { margin: 0; }
      .barra-acc { display: flex; gap: 8px; }
      .tabla-scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
      .tabla { border-collapse: collapse; width: 100%; font-size: .88rem; }
      .tabla th, .tabla td { padding: 6px 8px; border-bottom: 1px solid #f0ebe2; text-align: left; vertical-align: middle; }
      .tabla th { color: var(--muted); font-weight: 500; font-size: .78rem; white-space: nowrap; background: #fcfbf8; position: sticky; top: 0; }
      .tabla tr:last-child td { border-bottom: 0; }
      .tabla .num { text-align: right; }
      .tabla td.cod { font-family: ui-monospace, Menlo, monospace; font-size: .8rem; white-space: nowrap; color: var(--muted); }
      .tabla td.prod { min-width: 200px; }
      .tabla td.prod a { color: inherit; text-decoration: none; font-weight: 600; cursor: pointer; }
      .tabla td.prod a:hover { text-decoration: underline; }
      .tabla td.prod small { display: block; color: var(--muted); font-weight: 400; }
      .tabla input { padding: 4px 6px; min-width: 70px; }
      .tabla input.precio { width: 110px; text-align: right; }
      .tabla input.oferta { width: 110px; }
      .tabla input[type="checkbox"] { width: 18px; height: 18px; min-width: 0; }
      .tabla.var input { min-width: 90px; }
      .tabla.var input.cod { width: 100px; font-family: ui-monospace, Menlo, monospace; font-size: .82rem; }
      .tabla.var input.stock { width: 70px; min-width: 60px; }
      .tabla tr.oculto td { opacity: .55; }
      .tabla .quitar { border: 1px solid var(--line); background: #fff; border-radius: 8px; width: 32px; height: 32px; cursor: pointer; color: var(--muted); }
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 16px; }
      .card-io { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
      .card-io p { margin: 0; font-size: .9rem; }
      .acc { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      .acc input[type="url"] { flex: 1 1 200px; }
      .radio, .check { flex-direction: row; align-items: flex-start; gap: 8px; font-weight: 400; }
      .radio input, .check input { width: auto; margin-top: 3px; }
      .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
      .grid4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-top: 10px; }
      .vacio { text-align: center; color: var(--muted); padding: 60px 16px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
      dialog { border: 0; border-radius: 14px; padding: 0; width: min(1000px, calc(100vw - 16px)); max-height: calc(100dvh - 16px); background: var(--card); color: var(--ink); }
      dialog.chico { width: min(480px, calc(100vw - 16px)); }
      dialog::backdrop { background: rgba(30, 24, 16, .45); }
      dialog form { display: flex; flex-direction: column; max-height: calc(100dvh - 16px); }
      .dlg-head, .dlg-foot { display: flex; align-items: center; gap: 8px; padding: 14px 18px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
      .dlg-foot { border-bottom: 0; border-top: 1px solid var(--line); }
      .dlg-head h2 { flex: 1; }
      .x { border: 0; background: none; font-size: 1.6rem; line-height: 1; cursor: pointer; color: var(--muted); }
      .dlg-body { padding: 16px 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; }
      .grow { flex: 1; }
      fieldset { border: 1px solid var(--line); border-radius: 10px; padding: 12px; margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
      legend { font-weight: 600; padding: 0 6px; font-size: .92rem; }
      .fotos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
      .foto { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: var(--soft); border: 1px solid var(--line); }
      .foto img { width: 100%; height: 100%; object-fit: cover; }
      .foto .n { position: absolute; left: 6px; top: 6px; background: rgba(0,0,0,.6); color: #fff; font-size: .72rem; padding: 1px 6px; border-radius: 999px; }
      .foto .ctrl { position: absolute; right: 4px; bottom: 4px; display: flex; gap: 4px; }
      .foto .ctrl button { border: 0; background: rgba(255,255,255,.92); border-radius: 6px; cursor: pointer; padding: 2px 7px; }
      .foto.vacia { display: grid; place-items: center; color: var(--muted); font-size: .8rem; border-style: dashed; }
      .extra summary { cursor: pointer; font-weight: 600; font-size: .92rem; }
      .errores { margin: 0; padding: 10px 12px 10px 28px; background: #fdecea; color: var(--danger); border-radius: 8px; font-size: .9rem; }
      .toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 10px; max-width: calc(100vw - 32px); z-index: 50; box-shadow: 0 8px 24px rgba(0,0,0,.2); white-space: pre-line; }
      @media (max-width: 640px) {
        .top-inner { gap: 8px; }
        .tabs { order: 3; flex-basis: 100%; }
        #btnNuevo { margin-left: auto; padding: 6px 10px; }
        #estado { display: none; }
        .fotos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .lista { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
        .cards { grid-template-columns: 1fr; }
        .dlg-foot { flex-wrap: nowrap; gap: 6px; padding: 10px 12px; }
        .dlg-foot .btn { padding: 7px 10px; font-size: .88rem; }
        .dlg-foot .grow { display: none; }
        #btnCancelar { margin-left: auto; }
      }
    </style>

    <script>
      // ================================================================
      // Formato de importación de Tiendanube
      // ================================================================
      const COLUMNAS_TN = [
        'Identificador de URL', 'Nombre', 'Categorías',
        'Nombre de propiedad 1', 'Valor de propiedad 1', 'Nombre de propiedad 2', 'Valor de propiedad 2',
        'Nombre de propiedad 3', 'Valor de propiedad 3',
        'Precio', 'Precio promocional', 'Peso (kg)', 'Alto (cm)', 'Ancho (cm)', 'Profundidad (cm)',
        'Stock', 'SKU', 'Código de barras', 'Mostrar en tienda', 'Envío sin cargo', 'Descripción',
        'Tags', 'Título para SEO', 'Descripción para SEO', 'Marca', 'Producto Físico',
        'MPN (Número de pieza del fabricante)', 'Sexo', 'Rango de edad', 'Costo',
      ];
      // Formato simple (es el mismo que lee la lista online /precios)
      const COLUMNAS_SIMPLE = [
        'Código', 'Categoría', 'Subcategoría', 'Producto', 'Tela / material', 'Color', 'Medida', 'Detalle',
        'Precio lista', 'Efectivo / transferencia', 'Oferta', 'Publicar', 'Stock', 'Descripción',
        'Foto 1', 'Foto 2', 'Foto 3', 'Foto 4', 'Peso (kg)', 'Alto (cm)', 'Ancho (cm)', 'Profundidad (cm)',
      ];
      const MAX_FOTOS = 4;
      const MARCA = 'Bonté Deco';

      type Foto = { id: string; url?: string; blob?: Blob };
      type Variante = { id: string; codigo: string; color: string; medida: string; detalle: string; efectivo: number | null; lista: number | null; oferta: string; stock: string; publicar: boolean };
      type Producto = { id: string; creado: number; actualizado: number; nombre: string; categoria: string; subcategoria: string; tela: string; descripcion: string; fotos: Foto[]; variantes: Variante[]; peso: string; alto: string; ancho: string; profundidad: string };
      import { supabase } from '../lib/supabase';
      declare const XLSX: any;
      declare const JSZip: any;

      // ================================================================
      // Base de datos (Supabase)
      // ================================================================
      // Variantes y fotos que hay en la base por producto (para saber qué borrar al guardar)
      const remotoVar = new Map<string, Set<string>>();
      const remotoFotos = new Map<string, string[]>();
      const BUCKET = 'fotos';
      const pathDeUrl = (url = '') => { const m = url.match(/\/storage\/v1\/object\/public\/fotos\/(.+)$/); return m ? decodeURIComponent(m[1]) : null; };
      let guardando = 0;
      function estado(txt: string) { $('#estado').textContent = txt; }
      function errorDb(e: any, accion: string): never {
        const msg = String(e?.message || e || '');
        const amigable = /duplicate key|23505/.test(msg) ? 'hay un código repetido.' : /row-level security|permission|42501|JWT|401|403/.test(msg) ? 'tu usuario no tiene permiso o la sesión venció (volvé a ingresar).' : /Failed to fetch|NetworkError|network/i.test(msg) ? 'no hay conexión a internet.' : msg;
        estado('Error al guardar');
        toast(`No se pudo ${accion}: ${amigable}`, 7000);
        throw e;
      }
      const filaProducto = (p: Producto) => ({
        id: p.id, nombre: p.nombre, categoria: p.categoria, subcategoria: p.subcategoria, tela: p.tela, descripcion: p.descripcion,
        fotos: p.fotos.filter((f) => f.url).map((f) => ({ id: f.id, url: f.url })), peso: p.peso, alto: p.alto, ancho: p.ancho, profundidad: p.profundidad,
        orden: Math.round(p.creado), actualizado: new Date(p.actualizado || Date.now()).toISOString(),
      });
      const filaVariante = (p: Producto, v: Variante, i: number) => ({
        id: v.id, producto_id: p.id, codigo: v.codigo, color: v.color, medida: v.medida, detalle: v.detalle,
        efectivo: v.efectivo, lista: v.lista, oferta: v.oferta, stock: /^\d+$/.test(v.stock) ? Number(v.stock) : null, publicar: v.publicar, orden: i,
      });
      const deFila = (r: any): Producto => ({
        id: r.id, creado: Number(r.orden) || 0, actualizado: Date.parse(r.actualizado) || 0, nombre: r.nombre, categoria: r.categoria || '', subcategoria: r.subcategoria || '',
        tela: r.tela || '', descripcion: r.descripcion || '', fotos: (r.fotos || []).map((f: any) => ({ id: f.id || uid(), url: f.url })),
        peso: r.peso || '', alto: r.alto || '', ancho: r.ancho || '', profundidad: r.profundidad || '',
        variantes: (r.variantes || []).sort((x: any, y: any) => x.orden - y.orden).map((v: any) => ({
          id: v.id, codigo: v.codigo, color: v.color || '', medida: v.medida || '', detalle: v.detalle || '',
          efectivo: v.efectivo == null ? null : Number(v.efectivo), lista: v.lista == null ? null : Number(v.lista),
          oferta: v.oferta || '', stock: v.stock == null ? '' : String(v.stock), publicar: v.publicar !== false,
        })),
      });
      function recordar(p: Producto) {
        remotoVar.set(p.id, new Set(p.variantes.map((v) => v.id)));
        remotoFotos.set(p.id, p.fotos.map((f) => f.url!).filter(Boolean));
      }
      async function dbTodos(): Promise<Producto[]> {
        const todos: any[] = [];
        for (let desde = 0; ; desde += 1000) {
          const { data, error } = await supabase.from('productos').select('*, variantes(*)').order('orden').range(desde, desde + 999);
          if (error) throw error;
          todos.push(...data);
          if (data.length < 1000) break;
        }
        const { data: c } = await supabase.from('config').select('valor').eq('clave', 'recargo').maybeSingle();
        if (c && Number(c.valor) >= 0) cfg.recargo = Number(c.valor);
        remotoVar.clear(); remotoFotos.clear();
        const ps = todos.map(deFila);
        ps.forEach(recordar);
        return ps;
      }
      const lotes = <T,>(xs: T[], n = 400) => Array.from({ length: Math.ceil(xs.length / n) }, (_, i) => xs.slice(i * n, i * n + n));
      async function dbGuardar(ps: Producto[]) {
        if (!ps.length) return;
        guardando++; estado('Guardando…');
        try {
          // 1) subir fotos nuevas
          for (const p of ps) for (const f of p.fotos) {
            if (!f.blob) continue;
            const path = `${p.id}/${f.id}.jpg`;
            const { error } = await supabase.storage.from(BUCKET).upload(path, f.blob, { contentType: f.blob.type || 'image/jpeg', upsert: true });
            if (error) throw error;
            f.url = supabase.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
            delete f.blob;
          }
          // 2) borrar variantes que se quitaron (si no pasaron a otro producto de este lote)
          const quedan = new Set(ps.flatMap((p) => p.variantes.map((v) => v.id)));
          const borrar = ps.flatMap((p) => [...(remotoVar.get(p.id) || [])].filter((id) => !quedan.has(id)));
          for (const l of lotes(borrar, 100)) { const { error } = await supabase.from('variantes').delete().in('id', l); if (error) throw error; }
          // 3) productos y variantes
          for (const l of lotes(ps.map(filaProducto))) { const { error } = await supabase.from('productos').upsert(l); if (error) throw error; }
          const vs = ps.flatMap((p) => p.variantes.map((v, i) => filaVariante(p, v, i)));
          for (const l of lotes(vs)) { const { error } = await supabase.from('variantes').upsert(l); if (error) throw error; }
          // 4) fotos que se sacaron
          const sacar = ps.flatMap((p) => (remotoFotos.get(p.id) || []).filter((u) => !p.fotos.some((f) => f.url === u)).map(pathDeUrl).filter(Boolean) as string[]);
          if (sacar.length) await supabase.storage.from(BUCKET).remove(sacar);
          ps.forEach(recordar);
          estado('Guardado ✓');
        } catch (e) { errorDb(e, 'guardar'); }
        finally { guardando--; }
      }
      async function dbBorrar(id: string) {
        estado('Guardando…');
        const fotos = (remotoFotos.get(id) || []).map(pathDeUrl).filter(Boolean) as string[];
        const { error } = await supabase.from('productos').delete().eq('id', id);
        if (error) errorDb(error, 'borrar');
        if (fotos.length) await supabase.storage.from(BUCKET).remove(fotos);
        remotoVar.delete(id); remotoFotos.delete(id);
        estado('Guardado ✓');
      }
      async function dbBorrarTodo() {
        estado('Guardando…');
        const { error } = await supabase.from('productos').delete().not('id', 'is', null);
        if (error) errorDb(error, 'borrar');
        remotoVar.clear(); remotoFotos.clear();
        estado('Guardado ✓');
      }

      // ================================================================
      // Utilidades
      // ================================================================
      const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T;
const uid = (): string => (crypto.randomUUID ? crypto.randomUUID() : '10000000-1000-4000-8000-100000000000'.replace(/[018]/g, (c: any) => (c ^ (crypto.getRandomValues(new Uint8Array(1))[0] & (15 >> (c / 4)))).toString(16)));
      const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const norm = (s: unknown) => String(s ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
      const slugify = (s: string) => norm(s).replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 120);
      const pesos = (n: number | null | undefined) => (n ? '$ ' + Math.round(n).toLocaleString('es-AR') : '—');
      const fecha = () => new Date().toISOString().slice(0, 10);
      // "$ 94.800" | "$94,800" | "94800.50" | "94.800,50" -> número
      function numero(v: unknown): number | null {
        if (typeof v === 'number') return Number.isFinite(v) && v > 0 ? v : null;
        let t = String(v ?? '').replace(/[^\d.,]/g, '');
        const dec = t.match(/[.,](\d{1,2})$/);
        t = dec ? t.slice(0, -dec[0].length).replace(/[.,]/g, '') + '.' + dec[1] : t.replace(/[.,]/g, '');
        const n = Number(t);
        return t && Number.isFinite(n) && n > 0 ? n : null;
      }
      const esPrecio = (s: string) => /^[\s$\d.,]+$/.test(String(s ?? '').trim()) && numero(s) !== null;
      const textoPrecio = (n: number | null) => (n == null ? '' : String(n));
      function toast(msg: string, ms = 3500) {
        const t = $('#toast'); t.textContent = msg; t.hidden = false;
        clearTimeout((toast as any).t); (toast as any).t = setTimeout(() => (t.hidden = true), ms);
      }
      function descargar(blob: Blob, nombre: string) {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = nombre;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      }
      const urlCache = new WeakMap<Blob, string>();
      const srcFoto = (f: Foto) => f.url || (f.blob ? (urlCache.get(f.blob) ?? (urlCache.set(f.blob, URL.createObjectURL(f.blob)), urlCache.get(f.blob)!)) : '');
      async function achicarImagen(file: File): Promise<Blob> {
        try {
          const bmp = await createImageBitmap(file);
          const k = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
          const c = document.createElement('canvas');
          c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
          const ctx = c.getContext('2d')!; ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
          ctx.drawImage(bmp, 0, 0, c.width, c.height);
          return await new Promise((res) => c.toBlob((b) => res(b || file), 'image/jpeg', 0.86));
        } catch { return file; }
      }

      // ================================================================
      // Configuración y reglas de negocio
      // ================================================================
      const cfg = { recargo: 20 };
      const listaAuto = (efectivo: number | null) => (efectivo ? Math.round(efectivo * (1 + cfg.recargo / 100)) : null);
      const listaDe = (v: Variante) => v.lista ?? listaAuto(v.efectivo);

      let productos: Producto[] = [];

      function prefijoDe(categoria: string, excluir?: Producto): string {
        const cuenta = new Map<string, number>();
        productos.filter((p) => p !== excluir && norm(p.categoria) === norm(categoria)).forEach((p) => p.variantes.forEach((v) => {
          const m = v.codigo.match(/^([A-Za-z]+)-\d+$/); if (m) cuenta.set(m[1].toUpperCase(), (cuenta.get(m[1].toUpperCase()) || 0) + 1);
        }));
        if (cuenta.size) return [...cuenta].sort((a, b) => b[1] - a[1])[0][0];
        const base = norm(categoria).replace(/[^a-z]/g, '').toUpperCase();
        return (base.slice(0, 3) || 'PRD').padEnd(3, 'X');
      }
      function siguienteCodigo(categoria: string, usados: Set<string>): string {
        const pre = prefijoDe(categoria);
        let max = 0;
        usados.forEach((c) => { const m = c.match(new RegExp(`^${pre}-(\\d+)$`, 'i')); if (m) max = Math.max(max, Number(m[1])); });
        let cod = '';
        do { max++; cod = `${pre}-${String(max).padStart(3, '0')}`; } while (usados.has(cod.toUpperCase()));
        usados.add(cod.toUpperCase());
        return cod;
      }
      const codigosUsados = (excluir?: Producto) => new Set(productos.filter((p) => p.id !== excluir?.id).flatMap((p) => p.variantes.map((v) => v.codigo.trim().toUpperCase())).filter(Boolean));

      function nuevaVariante(parcial: Partial<Variante> = {}): Variante {
        return { id: uid(), codigo: '', color: '', medida: '', detalle: '', efectivo: null, lista: null, oferta: '', stock: '', publicar: true, ...parcial };
      }
      function nuevoProducto(parcial: Partial<Producto> = {}): Producto {
        const t = Date.now();
        return { id: uid(), creado: t, actualizado: t, nombre: '', categoria: '', subcategoria: '', tela: '', descripcion: '', fotos: [], variantes: [], peso: '', alto: '', ancho: '', profundidad: '', ...parcial };
      }

      const sinPrecio = (p: Producto) => p.variantes.some((v) => !v.efectivo && !v.lista);
      const publicado = (p: Producto) => p.variantes.some((v) => v.publicar);
      // Combinaciones repetidas = Tiendanube no las puede distinguir
      function combosRepetidos(p: Producto) {
        const k = p.variantes.map((v) => [v.color, v.medida, v.detalle].map(norm).join('|'));
        return p.variantes.length > 1 && new Set(k).size !== k.length;
      }
      function problemas(p: Producto): string[] {
        const e: string[] = [];
        if (!p.fotos.length) e.push('Sin foto');
        if (sinPrecio(p)) e.push('Sin precio');
        if (combosRepetidos(p)) e.push('Variantes repetidas');
        if (!publicado(p)) e.push('No publicado');
        return e;
      }

      // ================================================================
      // Render: filtros, productos, lista de precios
      // ================================================================
      let tab = 'productos';
      const filtro = () => ({ q: norm(($('#buscador') as HTMLInputElement).value), cat: ($('#filtroCat') as HTMLSelectElement).value, estado: ($('#filtroEstado') as HTMLSelectElement).value });
      const textoBusqueda = (p: Producto, v?: Variante) => norm([p.nombre, p.categoria, p.subcategoria, p.tela, ...(v ? [v.codigo, v.color, v.medida, v.detalle] : p.variantes.flatMap((x) => [x.codigo, x.color, x.medida, x.detalle]))].join(' '));
      function pasaFiltro(p: Producto, v?: Variante) {
        const f = filtro();
        if (f.cat && p.categoria !== f.cat) return false;
        if (f.estado === 'sinprecio' && !(v ? !v.efectivo && !v.lista : sinPrecio(p))) return false;
        if (f.estado === 'sinfoto' && p.fotos.length) return false;
        if (f.estado === 'oculto' && (v ? v.publicar : publicado(p) && p.variantes.every((x) => x.publicar))) return false;
        if (f.estado === 'problemas' && !problemas(p).length) return false;
        if (f.q) {
          const t = textoBusqueda(p, v); const t2 = t.replace(/[\s-]/g, '');
          if (!f.q.split(/\s+/).every((w) => t.includes(w) || t2.includes(w.replace(/-/g, '')))) return false;
        }
        return true;
      }
      const ordenados = () => [...productos].sort((a, b) => a.creado - b.creado);

      function renderTodo() {
        const cats = [...new Set(ordenados().map((p) => p.categoria).filter(Boolean))];
        const sel = $('#filtroCat') as HTMLSelectElement; const actual = sel.value;
        sel.innerHTML = '<option value="">Todas las categorías</option>' + cats.map((c) => `<option>${esc(c)}</option>`).join('');
        sel.value = cats.includes(actual) ? actual : '';
        $('#dlCategorias').innerHTML = cats.map((c) => `<option value="${esc(c)}">`).join('');
        $('#dlSubcategorias').innerHTML = [...new Set(productos.map((p) => p.subcategoria).filter(Boolean))].map((c) => `<option value="${esc(c)}">`).join('');
        $('#dlTelas').innerHTML = [...new Set(productos.map((p) => p.tela).filter(Boolean))].sort().map((c) => `<option value="${esc(c)}">`).join('');
        $('#vacio').hidden = productos.length > 0 || tab === 'io';
        $('#filtros').hidden = tab === 'io' || !productos.length;
        if (tab === 'productos') renderProductos();
        if (tab === 'precios') renderPrecios();
        const nVar = productos.reduce((a, p) => a + p.variantes.length, 0);
        $('#txtRecargo').textContent = String(cfg.recargo);
        const tip = `En Tiendanube podés configurar un descuento del ${(100 - 10000 / (100 + cfg.recargo)).toFixed(2).replace('.', ',')}% para pagos por transferencia: así el precio con descuento coincide con el de efectivo.`;
        $('#tnTip').textContent = tip;
        ($('#cfgRecargo') as HTMLInputElement).value = String(cfg.recargo);
        return nVar;
      }

      function renderProductos() {
        const vis = ordenados().filter((p) => pasaFiltro(p));
        $('#resumen').textContent = `${vis.length} de ${productos.length} productos`;
        $('#listaProductos').innerHTML = vis.map((p) => {
          const precios = p.variantes.map((v) => v.efectivo).filter((x): x is number => !!x);
          const min = precios.length ? Math.min(...precios) : null; const max = precios.length ? Math.max(...precios) : null;
          const rango = min == null ? 'Sin precio' : min === max ? pesos(min) : `${pesos(min)} – ${pesos(max)}`;
          const probs = problemas(p);
          return `<button type="button" class="card" data-id="${p.id}">
            <div class="img">${p.fotos[0] ? `<img src="${esc(srcFoto(p.fotos[0]))}" alt="" loading="lazy">` : 'Sin foto'}</div>
            <div class="info">
              <span class="nom">${esc(p.nombre || 'Sin nombre')}</span>
              <span class="cat">${esc([p.categoria, p.tela].filter(Boolean).join(' · '))} · ${p.variantes.length} ${p.variantes.length === 1 ? 'variante' : 'variantes'}</span>
              <div class="pie"><strong>${rango}</strong>
                <span class="badges">${probs.filter((x) => x !== 'Sin foto').map((x) => `<span class="badge${x === 'No publicado' ? ' gris' : ''}">${x}</span>`).join('')}</span>
              </div>
            </div>
          </button>`;
        }).join('');
      }

      function renderPrecios() {
        const filas: [Producto, Variante][] = [];
        ordenados().forEach((p) => p.variantes.forEach((v) => { if (pasaFiltro(p, v)) filas.push([p, v]); }));
        const total = productos.reduce((a, p) => a + p.variantes.length, 0);
        $('#resumen').textContent = `${filas.length} de ${total} códigos`;
        const LIM = 600;
        $('#tablaPrecios tbody').innerHTML = filas.slice(0, LIM).map(([p, v]) => `<tr data-p="${p.id}" data-v="${v.id}" class="${v.publicar ? '' : 'oculto'}">
            <td class="cod">${esc(v.codigo)}</td>
            <td class="prod"><a data-abrir="${p.id}">${esc(p.nombre)}</a><small>${esc([p.categoria, p.tela].filter(Boolean).join(' · '))}</small></td>
            <td>${esc(v.color)}</td><td>${esc(v.medida)}</td><td>${esc(v.detalle)}</td>
            <td class="num"><input class="precio" data-k="efectivo" inputmode="decimal" value="${esc(textoPrecio(v.efectivo))}" aria-label="Precio efectivo ${esc(v.codigo)}"></td>
            <td class="num"><input class="precio" data-k="lista" inputmode="decimal" value="${esc(textoPrecio(v.lista))}" placeholder="${esc(textoPrecio(listaAuto(v.efectivo)))}" aria-label="Precio lista ${esc(v.codigo)}"></td>
            <td><input class="oferta" data-k="oferta" value="${esc(v.oferta)}" aria-label="Oferta ${esc(v.codigo)}"></td>
            <td><input type="checkbox" data-k="publicar" ${v.publicar ? 'checked' : ''} aria-label="Publicar ${esc(v.codigo)}"></td>
          </tr>`).join('') + (filas.length > LIM ? `<tr><td colspan="9" class="muted">Se muestran ${LIM} de ${filas.length}. Usá el buscador para ver el resto.</td></tr>` : '');
      }

      // Edición en línea de la lista de precios (se guarda sola)
      const pendientes = new Set<Producto>();
      let tGuardar: any;
      function guardarLuego(p: Producto) {
        p.actualizado = Date.now(); pendientes.add(p);
        clearTimeout(tGuardar);
        estado('Cambios sin guardar…');
        tGuardar = setTimeout(async () => { const ps = [...pendientes]; pendientes.clear(); try { await dbGuardar(ps); } catch {} }, 500);
      }
      addEventListener('beforeunload', (e) => { if (pendientes.size || guardando) { e.preventDefault(); e.returnValue = ''; } });
      $('#tablaPrecios').addEventListener('change', (ev) => {
        const inp = ev.target as HTMLInputElement; const tr = inp.closest('tr'); if (!tr || !inp.dataset.k) return;
        const p = productos.find((x) => x.id === tr.dataset.p)!; const v = p.variantes.find((x) => x.id === tr.dataset.v)!;
        const k = inp.dataset.k;
        if (k === 'publicar') { v.publicar = inp.checked; tr.classList.toggle('oculto', !v.publicar); }
        else if (k === 'oferta') v.oferta = inp.value.trim();
        else {
          const n = inp.value.trim() ? numero(inp.value) : null;
          if (inp.value.trim() && n == null) { toast('Ese precio no es un número.'); inp.value = textoPrecio((v as any)[k]); return; }
          (v as any)[k] = n == null ? null : Math.round(n * 100) / 100;
          if (k === 'lista' && n != null && n === listaAuto(v.efectivo)) v.lista = null; // igual al automático
          inp.value = textoPrecio((v as any)[k]);
          if (k === 'efectivo') ($('input[data-k="lista"]', tr) as HTMLInputElement).placeholder = textoPrecio(listaAuto(v.efectivo));
        }
        guardarLuego(p);
      });
      $('#tablaPrecios').addEventListener('click', (ev) => {
        const a = (ev.target as HTMLElement).closest<HTMLElement>('[data-abrir]');
        if (a) abrir(productos.find((p) => p.id === a.dataset.abrir));
      });
      $('#tablaPrecios').addEventListener('keydown', (ev) => {
        // Enter baja a la fila siguiente, como en Excel
        const e = ev as KeyboardEvent; const inp = e.target as HTMLInputElement;
        if (e.key !== 'Enter' || inp.tagName !== 'INPUT' || inp.type === 'checkbox') return;
        e.preventDefault(); inp.blur();
        const sig = inp.closest('tr')?.nextElementSibling?.querySelector<HTMLInputElement>(`input[data-k="${inp.dataset.k}"]`);
        sig?.focus(); sig?.select();
