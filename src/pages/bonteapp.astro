        $('#dlgTitulo').textContent = esNuevo ? (copia ? 'Duplicar producto' : 'Nuevo producto') : 'Editar producto';
        $('#btnEliminar').hidden = esNuevo; $('#btnDuplicar').hidden = esNuevo;
