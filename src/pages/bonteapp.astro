        ['productos', 'precios', 'io'].forEach((x) => ($('#tab-' + x).hidden = x !== t));
        try { localStorage.setItem('bonteapp-tab', t); } catch {}
        renderTodo();
      }
      document.querySelectorAll<HTMLElement>('.tab').forEach((b) => b.addEventListener('click', () => irA(b.dataset.tab!)));
