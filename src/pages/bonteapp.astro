      $('#buscador').addEventListener('input', () => { clearTimeout(tBus); tBus = setTimeout(renderTodo, 120); });
      $('#filtroCat').addEventListener('change', renderTodo);
      $('#filtroEstado').addEventListener('change', renderTodo);
      $('#listaProductos').addEventListener('click', (ev) => {
        const c = (ev.target as HTMLElement).closest<HTMLElement>('.card');
        if (c) abrir(productos.find((p) => p.id === c.dataset.id));
