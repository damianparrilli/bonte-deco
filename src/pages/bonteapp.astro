      // ================================================================
      // Exportar Tiendanube
      // ================================================================
      const escCat = (s: string) => s.trim().replace(/\\/g, '\\\\').replace(/,/g, '\\,').replace(/>/g, '\\>');
      function descripcionTN(p: Producto, vs: Variante[]) {
        const partes: string[] = [];
        if (p.descripcion) partes.push(p.descripcion.split(/\n{2,}/).map((x) => `<p>${esc(x).replace(/\n/g, '<br>')}</p>`).join(''));
        const datos: [string, string][] = [['Tela', p.tela]];
        // datos iguales en todas las variantes (no son propiedades en Tiendanube)
        ([['Color', 'color'], ['Medida', 'medida'], ['Detalle', 'detalle']] as const).forEach(([nom, k]) => {
          if (new Set(vs.map((v) => norm(v[k]))).size === 1) datos.push([nom, vs[0][k]]);
        });
        const li = datos.filter(([, v]) => v).map(([k, v]) => `<li><strong>${k}:</strong> ${esc(v)}</li>`);
        if (li.length) partes.push(`<ul>${li.join('')}</ul>`);
        return partes.join('');
      }
      function exportarTN() {
        const usarLista = ($('#tnPrecio') as HTMLSelectElement).value === 'lista';
        const ofertas = ($('#tnOfertas') as HTMLInputElement).checked;
        const soloPub = ($('#tnSoloPub') as HTMLInputElement).checked;
        const filas: Record<string, string>[] = [];
        const avisos: string[] = [];
        const slugs = new Set<string>();
        const nombres = new Map<string, number>();
        const lista = ordenados().map((p) => ({ p, vs: p.variantes.filter((v) => !soloPub || v.publicar) })).filter((x) => x.vs.length);
        lista.forEach(({ p }) => nombres.set(norm(p.nombre), (nombres.get(norm(p.nombre)) || 0) + 1));
        let nProd = 0;
        lista.forEach(({ p, vs }) => {
          // propiedades que cambian entre variantes
          const props = ([['Color', 'color'], ['Medida', 'medida'], ['Modelo', 'detalle']] as const)
            .filter(([, k]) => vs.length > 1 && new Set(vs.map((v) => norm(v[k]))).size > 1);
          if (vs.length > 1 && !props.length) { avisos.push(`${p.nombre}: tiene ${vs.length} variantes iguales (sin color/medida/modelo distintos). No se exportó.`); return; }
          const combos = vs.map((v) => props.map(([, k]) => norm(v[k])).join('|'));
          if (new Set(combos).size !== combos.length) { avisos.push(`${p.nombre}: hay variantes con la misma combinación de ${props.map((x) => x[0].toLowerCase()).join('/')}. No se exportó.`); return; }
          let nombre = p.nombre;
          if ((nombres.get(norm(p.nombre)) || 0) > 1) nombre = [p.nombre, p.tela || p.categoria].filter(Boolean).join(' - ');
          let slug = slugify(nombre) || slugify(vs[0].codigo); let s2 = slug; let n = 2;
          while (slugs.has(s2)) s2 = `${slug}-${n++}`;
          slugs.add(s2);
          vs.forEach((v, i) => {
            const f: Record<string, string> = Object.fromEntries(COLUMNAS_TN.map((c) => [c, '']));
            f['Identificador de URL'] = s2;
            props.forEach(([nom, k], j) => { f[`Nombre de propiedad ${j + 1}`] = nom; f[`Valor de propiedad ${j + 1}`] = v[k] || 'Único'; });
            const precio = usarLista ? listaDe(v) : v.efectivo;
            f['Precio'] = precio ? String(precio) : '';
            if (!precio) avisos.push(`${v.codigo} (${p.nombre}): sin precio.`);
            if (ofertas && esPrecio(v.oferta)) {
              const o = numero(v.oferta)!;
              if (precio && o < precio) f['Precio promocional'] = String(o);
            }
            f['Peso (kg)'] = numero(p.peso) ? String(numero(p.peso)) : '';
            f['Alto (cm)'] = numero(p.alto) ? String(numero(p.alto)) : '';
            f['Ancho (cm)'] = numero(p.ancho) ? String(numero(p.ancho)) : '';
            f['Profundidad (cm)'] = numero(p.profundidad) ? String(numero(p.profundidad)) : '';
            f['Stock'] = v.stock;
            f['SKU'] = v.codigo;
            if (i === 0) {
              f['Nombre'] = nombre;
              f['Categorías'] = p.subcategoria ? `${escCat(p.categoria)} > ${escCat(p.subcategoria)}` : escCat(p.categoria);
              f['Mostrar en tienda'] = vs.some((x) => x.publicar) ? 'SI' : 'NO';
              f['Envío sin cargo'] = 'NO';
              f['Descripción'] = descripcionTN(p, vs);
              f['Tags'] = [p.categoria, p.tela].filter(Boolean).join(', ');
              f['Marca'] = MARCA;
              f['Producto Físico'] = 'SI';
            }
            filas.push(f);
          });
          nProd++;
        });
        return { filas, avisos, nProd };
      }
      function csv(filas: Record<string, string>[], cols: string[], sep: string) {
        const celda = (v: string) => { const s = String(v ?? ''); return /["\r\n]/.test(s) || s.includes(sep) || /^\s|\s$/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; };
        return [cols, ...filas.map((f) => cols.map((c) => f[c]))].map((r) => r.map(celda).join(sep)).join('\r\n') + '\r\n';
      }
