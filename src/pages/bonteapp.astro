      function renderFotos() {
        const celdas = editando.fotos.map((f, i) => `<div class="foto" data-i="${i}"><img src="${esc(srcFoto(f))}" alt="Foto ${i + 1}">
          <span class="n">${i === 0 ? 'Principal' : i + 1}</span>
          <div class="ctrl">${i > 0 ? '<button type="button" data-acc="izq" title="Mover a la izquierda">←</button>' : ''}<button type="button" data-acc="quitar" title="Quitar">✕</button></div></div>`);
        for (let i = editando.fotos.length; i < MAX_FOTOS; i++) celdas.push(`<div class="foto vacia">Foto ${i + 1}</div>`);
        $('#fotos').innerHTML = celdas.join('');
        const lleno = editando.fotos.length >= MAX_FOTOS;
        ['#inpFotos', '#inpFotoUrl', '#btnFotoUrl'].forEach((s) => (($(s) as HTMLInputElement).disabled = lleno));
      }
      $('#fotos').addEventListener('click', (ev) => {
        const b = (ev.target as HTMLElement).closest('button'); if (!b) return;
        const i = Number(b.closest<HTMLElement>('.foto')!.dataset.i);
        if (b.dataset.acc === 'quitar') editando.fotos.splice(i, 1);
        else [editando.fotos[i - 1], editando.fotos[i]] = [editando.fotos[i], editando.fotos[i - 1]];
        renderFotos();
      });
      $('#inpFotos').addEventListener('change', async (ev) => {
        const inp = ev.target as HTMLInputElement; const files = [...(inp.files || [])];
        const lugar = MAX_FOTOS - editando.fotos.length;
        if (files.length > lugar) toast(`Se agregaron ${lugar}: el máximo es ${MAX_FOTOS} fotos.`);
        for (const f of files.slice(0, lugar)) editando.fotos.push({ id: uid(), blob: await achicarImagen(f) });
        inp.value = ''; renderFotos();
      });
      function agregarFotoUrl() {
        const inp = $('#inpFotoUrl') as HTMLInputElement; const url = inp.value.trim();
        if (!/^https?:\/\//i.test(url)) { toast('Pegá un link que empiece con http:// o https://'); return; }
        if (editando.fotos.length < MAX_FOTOS) editando.fotos.push({ id: uid(), url });
        inp.value = ''; renderFotos();
      }
      $('#btnFotoUrl').addEventListener('click', agregarFotoUrl);
      $('#inpFotoUrl').addEventListener('keydown', (ev) => { if ((ev as KeyboardEvent).key === 'Enter') { ev.preventDefault(); agregarFotoUrl(); } });

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        CAMPOS.forEach((c) => ((editando as any)[c] = campo(c).value.trim()));
        editando.variantes = editando.variantes.filter((v) => v.codigo.trim() || v.color.trim() || v.medida.trim() || v.detalle.trim() || v.efectivo || v.lista);
        editando.variantes.forEach((v) => { (['codigo', 'color', 'medida', 'detalle', 'oferta', 'stock'] as const).forEach((k) => (v[k] = String(v[k] ?? '').trim())); if (v.lista != null && v.lista === listaAuto(v.efectivo)) v.lista = null; });
        const errs: string[] = [];
        if (!editando.nombre) errs.push('Falta el nombre.');
        if (!editando.categoria) errs.push('Falta la categoría.');
        if (!editando.variantes.length) errs.push('Agregá al menos una variante (con su precio).');
        const usados = codigosUsados(editando);
        const propios = new Set<string>();
        editando.variantes.forEach((v) => {
          const c = v.codigo.toUpperCase(); if (!c) return;
          if (usados.has(c)) errs.push(`El código ${v.codigo} ya lo usa otro producto.`);
          if (propios.has(c)) errs.push(`El código ${v.codigo} está repetido.`);
          propios.add(c);
        });
        editando.variantes.forEach((v) => { if (v.stock && !/^\d+$/.test(v.stock)) errs.push(`Stock de ${v.codigo || 'una variante'}: tiene que ser un número entero.`); });
        if (errs.length) {
          const ul = $('#errores'); ul.innerHTML = errs.map((e) => `<li>${esc(e)}</li>`).join(''); ul.hidden = false;
          ul.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); return;
        }
        const todos = new Set([...usados, ...propios]);
        editando.variantes.forEach((v) => { if (!v.codigo) v.codigo = siguienteCodigo(editando.categoria, todos); });
        editando.actualizado = Date.now();
        const btnG = form.querySelector('button[type=submit]') as HTMLButtonElement;
        btnG.disabled = true;
        try { await dbGuardar([editando]); } catch { return; } finally { btnG.disabled = false; }
        const i = productos.findIndex((p) => p.id === editando.id);
        if (i >= 0) productos[i] = editando; else productos.push(editando);
        dlg.close(); renderTodo();
        const avisos = problemas(editando).filter((x) => x !== 'No publicado');
        toast(avisos.length ? `Guardado. Ojo: ${avisos.join(', ').toLowerCase()}.` : 'Producto guardado ✓');
      });
      $('#btnCerrar').addEventListener('click', () => dlg.close());
      $('#btnCancelar').addEventListener('click', () => dlg.close());
      $('#btnDuplicar').addEventListener('click', () => abrir(productos.find((p) => p.id === editando.id), true));
      $('#btnEliminar').addEventListener('click', async () => {
        if (!confirm(`¿Eliminar "${editando.nombre}" y sus ${editando.variantes.length} variantes?`)) return;
        await dbBorrar(editando.id);
        productos = productos.filter((p) => p.id !== editando.id);
        dlg.close(); renderTodo(); toast('Producto eliminado');
      });
      $('#btnNuevo').addEventListener('click', () => abrir());

      // ================================================================
      // Aumento masivo de precios
      // ================================================================
      const dlgA = $('#dlgAumento') as HTMLDialogElement;
      const filasFiltradas = () => ordenados().flatMap((p) => p.variantes.filter((v) => pasaFiltro(p, v)).map((v) => [p, v] as [Producto, Variante]));
      $('#btnAumento').addEventListener('click', () => {
        const n = filasFiltradas().length;
        const f = filtro();
        $('#aumAlcance').textContent = `Se va a aplicar a ${n} códigos${f.q || f.cat || f.estado ? ' (los que muestra el filtro actual)' : ' (toda la lista)'}.`;
        dlgA.showModal();
      });
      $('#aumCancelar').addEventListener('click', () => dlgA.close());
      $('#formAumento').addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const pct = Number(($('#aumPct') as HTMLInputElement).value);
        const red = Number(($('#aumRedondeo') as HTMLSelectElement).value);
        const ofertas = ($('#aumOfertas') as HTMLInputElement).checked;
        if (!pct) { dlgA.close(); return; }
        const aplicar = (n: number) => Math.max(red, Math.round((n * (1 + pct / 100)) / red) * red);
        const tocados = new Set<Producto>();
        filasFiltradas().forEach(([p, v]) => {
          if (v.efectivo) v.efectivo = aplicar(v.efectivo);
          if (ofertas && v.lista) v.lista = aplicar(v.lista);
          if (ofertas && esPrecio(v.oferta)) v.oferta = String(aplicar(numero(v.oferta)!));
          p.actualizado = Date.now(); tocados.add(p);
        });
        await dbGuardar([...tocados]);
        dlgA.close(); renderTodo();
        toast(`Precios actualizados (${pct > 0 ? '+' : ''}${pct}%) en ${tocados.size} productos.`);
      });

      // ================================================================
      // Importar formato simple (Excel / CSV)
      // ================================================================
      function leerHoja(buf: ArrayBuffer, nombre: string): any[][] {
        if (typeof XLSX === 'undefined') throw new Error('No se pudo cargar la librería de Excel (revisá la conexión).');
        const wb = /\.csv$/i.test(nombre)
          ? XLSX.read(new TextDecoder('utf-8').decode(buf), { type: 'string', raw: true })
          : XLSX.read(buf, { type: 'array' });
        const hoja = wb.SheetNames.find((n: string) => norm(n) === 'lista de precios') || wb.SheetNames[0];
        return XLSX.utils.sheet_to_json(wb.Sheets[hoja], { header: 1, defval: '', raw: true });
      }
      const ALIAS: Record<string, string[]> = {
        codigo: ['codigo', 'sku', 'cod'], categoria: ['categoria', 'rubro'], subcategoria: ['subcategoria'],
        producto: ['producto', 'nombre'], tela: ['tela', 'material'], color: ['color'], medida: ['medida', 'tamano', 'talle'],
        detalle: ['detalle', 'modelo'], lista: ['precio lista', 'lista'], efectivo: ['efectivo', 'precio efectivo', 'contado', 'transferencia'],
        oferta: ['oferta'], publicar: ['publicar', 'mostrar'], stock: ['stock'], descripcion: ['descripcion'],
        foto1: ['foto 1', 'foto1', 'imagen 1'], foto2: ['foto 2', 'foto2', 'imagen 2'], foto3: ['foto 3', 'foto3', 'imagen 3'], foto4: ['foto 4', 'foto4', 'imagen 4'],
        peso: ['peso'], alto: ['alto'], ancho: ['ancho'], profundidad: ['profundidad'],
      };
      function mapearColumnas(enc: any[]): Record<string, number> {
        const h = enc.map((x) => norm(x));
        const m: Record<string, number> = {};
        Object.entries(ALIAS).forEach(([k, alias]) => {
          const i = h.findIndex((x) => alias.some((a) => x === a || x.startsWith(a + ' ') || x.startsWith(a + '/') || x.startsWith(a + ' (')));
          if (i >= 0) m[k] = i;
        });
        return m;
      }
      type FilaImport = Record<string, string> & { _lista: number | null; _efectivo: number | null; _fila: number };
      function filasDesde(tabla: any[][]): { filas: FilaImport[]; error?: string } {
        const iEnc = tabla.findIndex((r) => { const m = mapearColumnas(r); return m.producto !== undefined && (m.efectivo !== undefined || m.lista !== undefined); });
        if (iEnc < 0) return { filas: [], error: 'No encontré los encabezados. Tiene que haber al menos las columnas "Producto" y "Efectivo / transferencia" (o "Precio lista"). Descargá la plantilla para ver el formato.' };
        const m = mapearColumnas(tabla[iEnc]);
        const filas: FilaImport[] = [];
        tabla.slice(iEnc + 1).forEach((r, k) => {
          const get = (c: string) => (m[c] === undefined ? '' : String(r[m[c]] ?? '').trim());
          if (!get('producto') && !get('codigo')) return;
          const f: any = {}; Object.keys(ALIAS).forEach((c) => (f[c] = get(c)));
          f._lista = m.lista === undefined ? null : numero(r[m.lista]);
          f._efectivo = m.efectivo === undefined ? null : numero(r[m.efectivo]);
          f._fila = iEnc + k + 2;
          f._tiene = m;
          filas.push(f);
        });
        return { filas };
      }
      function aplicarImport(filas: FilaImport[], reemplazar: boolean) {
        let base: Producto[] = reemplazar ? [] : structuredClone(productos);
        const porCodigo = new Map<string, [Producto, Variante]>();
        base.forEach((p) => p.variantes.forEach((v) => v.codigo && porCodigo.set(v.codigo.toUpperCase(), [p, v])));
        const clave = (cat: string, nom: string, tela: string) => [cat, nom, tela].map(norm).join('|');
        const porClave = new Map<string, Producto>(base.map((p) => [clave(p.categoria, p.nombre, p.tela), p]));
        const res = { nuevosProd: 0, nuevasVar: 0, actualizadas: 0, avisos: [] as string[], eliminados: [] as string[] };
        const tocados = new Set<Producto>();
        const t0 = Date.now();
        filas.forEach((f, k) => {
          const tiene = (f as any)._tiene as Record<string, number>;
          const efectivo = f._efectivo ?? (f._lista ? Math.round(f._lista / (1 + cfg.recargo / 100)) : null);
          const lista = f._lista && Math.abs(f._lista - (listaAuto(efectivo) || 0)) > 1 ? f._lista : null;
          const publicar = tiene.publicar === undefined ? true : !['no', 'n', 'false', '0'].includes(norm(f.publicar));
          const fotos = ['foto1', 'foto2', 'foto3', 'foto4'].map((c) => f[c]).filter((u) => /^https?:\/\//i.test(u));
          const datosVar: Partial<Variante> = { color: f.color, medida: f.medida, detalle: f.detalle, efectivo, lista, oferta: f.oferta, stock: f.stock.replace(/\D/g, ''), publicar };
          const existente = f.codigo ? porCodigo.get(f.codigo.toUpperCase()) : undefined;
          // producto destino según Categoría + Producto + Tela (si el archivo los trae)
          const destino = (pActual?: Producto) => {
            const cat = tiene.categoria !== undefined ? f.categoria || pActual?.categoria || 'Sin categoría' : pActual?.categoria || 'Sin categoría';
            const nom = tiene.producto !== undefined ? f.producto || pActual?.nombre || f.codigo : pActual?.nombre || f.codigo;
            const tela = tiene.tela !== undefined ? f.tela : pActual?.tela || '';
            const kc = clave(cat, nom, tela);
            let p = porClave.get(kc);
            if (!p) {
              p = nuevoProducto({ nombre: nom, categoria: cat, tela, creado: t0 + k });
              base.push(p); porClave.set(kc, p); res.nuevosProd++;
            }
            return p;
          };
          let p: Producto;
          if (existente) {
            const [pe, ve] = existente;
            // solo se pisan las columnas que vienen en el archivo
            if (tiene.color !== undefined) ve.color = f.color;
            if (tiene.medida !== undefined) ve.medida = f.medida;
            if (tiene.detalle !== undefined) ve.detalle = f.detalle;
            if (tiene.oferta !== undefined) ve.oferta = f.oferta;
            if (tiene.stock !== undefined) ve.stock = datosVar.stock!;
            if (tiene.publicar !== undefined) ve.publicar = publicar;
            if (tiene.efectivo !== undefined || tiene.lista !== undefined) ve.efectivo = efectivo;
            if (tiene.lista !== undefined) ve.lista = lista;
            p = destino(pe);
            if (p !== pe) {
              // cambió de producto / categoría / tela: se mueve la variante
              pe.variantes = pe.variantes.filter((x) => x !== ve);
              p.variantes.push(ve); porCodigo.set(ve.codigo.toUpperCase(), [p, ve]);
              tocados.add(pe);
              if (!pe.variantes.length) { base = base.filter((x) => x !== pe); res.eliminados.push(pe.id); if (pe.fotos.length && !p.fotos.length) p.fotos = pe.fotos; }
            }
            res.actualizadas++;
          } else {
            p = destino();
            const v = nuevaVariante({ ...datosVar, codigo: f.codigo });
            p.variantes.push(v);
            if (v.codigo) porCodigo.set(v.codigo.toUpperCase(), [p, v]);
            res.nuevasVar++;
            if (!f.categoria) res.avisos.push(`Fila ${f._fila}: sin categoría.`);
          }
          // datos del producto (solo si vienen en el archivo)
          if (f.subcategoria) p.subcategoria = f.subcategoria;
          if (f.descripcion) p.descripcion = f.descripcion;
          (['peso', 'alto', 'ancho', 'profundidad'] as const).forEach((c) => { if (f[c]) p[c] = f[c]; });
          fotos.forEach((u) => { if (p.fotos.length < MAX_FOTOS && !p.fotos.some((x) => x.url === u)) p.fotos.push({ id: uid(), url: u }); });
          p.actualizado = Date.now();
          tocados.add(p);
        });
        // códigos faltantes
        const usados = new Set(base.flatMap((p) => p.variantes.map((v) => v.codigo.toUpperCase())).filter(Boolean));
        const prev = productos; productos = base;
        base.forEach((p) => p.variantes.forEach((v) => { if (!v.codigo) { v.codigo = siguienteCodigo(p.categoria, usados); tocados.add(p); } }));
        productos = prev;
        return { base, tocados, res };
      }

