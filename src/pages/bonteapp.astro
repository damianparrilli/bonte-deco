      let editando: Producto = nuevoProducto();
      let esNuevo = true;

      function abrir(p?: Producto, copia = false) {
        esNuevo = !p || copia;
        editando = p ? structuredClone(p) : nuevoProducto({ variantes: [nuevaVariante()] });
        if (copia) {
          editando.id = uid(); editando.creado = Date.now(); editando.nombre += ' (copia)';
          editando.variantes = editando.variantes.map((v) => ({ ...v, id: uid(), codigo: '' }));
