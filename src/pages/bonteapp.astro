        if (!session) return vista('formLogin');
        if (/type=(invite|recovery|signup)/.test(hashInicial)) {
          $('#claveEmail').textContent = session.user.email || '';
          return vista('formClave');
        }
        entrar();
      })();
    </script>
  </body>
</html>
